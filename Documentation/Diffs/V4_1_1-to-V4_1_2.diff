+using System;
+using UnityEngine;
+namespace Orbis
+{
+    /// <summary>Optical constants from the uploaded atmosphere.glsl, converted from metres
+    /// to the existing ORBIS 1.0R planet / 1.20R atmosphere. This is an art-scaled atmosphere,
+    /// NOT a 6371 km Earth. The extended terrain/cloud geometry is deliberately retained.</summary>
+    [Serializable]
+    public sealed class OrbisAtmosphereProfile
+    {
+        public const float OuterRadius=1.20f;
+        public const float CloudBase=1.085f,CloudTop=1.132f;
+        public const string SourceSHA256="708ea4a9141a7653ea0085d7f26ae09ca09bb14c88e339d63da74e16439300bd";
+        [Tooltip("Reference 8 km Rayleigh height multiplier; 2 fits the exaggerated ORBIS terrain. Coefficients compensate to retain its vertical optical depth.")]
+        [Range(1,3)] public float rayleighHeightStretch=2f;
+        [Tooltip("Reference 1.2 km aerosol height multiplier; compensating beta preserves the reference vertical optical depth.")]
+        [Range(1,5)] public float mieHeightStretch=3.3333333f;
+        [Range(-.9f,.9f)] public float mieAnisotropy=.7f;
+        [Tooltip("Air-source radiance: reference demo uses 40; 12 balances the existing ORBIS surface lighting and ACES display.")]
+        [Range(1,60)] public float solarRadiance=12f;
+        [Range(0,2)] public float ozoneStrength=1f;
+        [Range(.1f,1.2f)] public float sunAngularRadiusDegrees=.53f;
+        static readonly int[] LightBudget={12,16,20,24};
+        public void Bind(Material material,int quality)
+        {
+            if(!material)return;
+            // 100 km reference column -> 0.20 R visual column. Beta has units 1/length.
+            const float metresPerR=100000f/.20f;
+            float r=Mathf.Clamp(rayleighHeightStretch,1,3),m=Mathf.Clamp(mieHeightStretch,1,5);
+            material.SetVector("_AtmoBetaRayleigh",new Vector4(5.5e-6f*metresPerR/r,13e-6f*metresPerR/r,22.4e-6f*metresPerR/r,8000f*r/metresPerR));
+            material.SetVector("_AtmoBetaMie",new Vector4(21e-6f*metresPerR/m,21e-6f*metresPerR/m,21e-6f*metresPerR/m,1200f*m/metresPerR));
+            float o=Mathf.Clamp(ozoneStrength,0,2);
+            material.SetVector("_AtmoBetaAbsorption",new Vector4(2.04e-5f*metresPerR*o,4.97e-5f*metresPerR*o,1.95e-6f*metresPerR*o,30000f/metresPerR));
+            material.SetVector("_AtmoParameters",new Vector4(4000f/metresPerR,Mathf.Clamp(mieAnisotropy,-.9f,.9f),Mathf.Clamp(solarRadiance,1,60),LightBudget[Mathf.Clamp(quality,0,3)]));
+            material.SetVector("_AtmoSunDisk",new Vector4(Mathf.Cos(Mathf.Clamp(sunAngularRadiusDegrees,.1f,1.2f)*Mathf.Deg2Rad),3f,0,0));
+        }
+    }
+}
