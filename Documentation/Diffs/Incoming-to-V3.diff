+                float lift=0;
+                foreach(int j in world.grid.neighbors[i])
+                {
+                    Vector3 downstream=Vector3.ProjectOnPlane(world.grid.points[j]-world.grid.points[i],world.grid.points[i]).normalized;
+                    lift+=Mathf.Max(0,Vector3.Dot(t.cloudWind,downstream))*Mathf.Max(0,world.tiles[j].h-t.h);
+                }
