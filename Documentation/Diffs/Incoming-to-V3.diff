+            if(clock>=nextRefresh){nextRefresh=clock+.3;RefreshColors();}
+        }
+        void Build(Vector3 at,float size,int quality)
+        {
+            // Parallel-transport the old horizontal axis when re-anchoring; no polar cross(up,n) singularity.
+            Vector3 oldRight=right;center=at;radius=size;
