+namespace Orbis
+{
+    /// <summary>Game-scale two-reservoir weather, not a numerical forecast model.
+    /// Fixed-step spherical advection is monotone but not globally mass-conservative.</summary>
+    public sealed class OrbisWeather
+    {
+        public const double FixedStep=.1;
+        public const float FlowPeriod=12f;
+        public const float AngularSpeed=.014f;
