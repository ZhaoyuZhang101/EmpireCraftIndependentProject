+                Vector3 source=OrbisSphericalSampler.Backtrace(world.grid.points[i],winds[i],dt);
+                var s=sampler.Locate(source,i);nextVapor[i]=s.Read(vapor);nextCloud[i]=s.Read(cloud);
+            }
+            for(int i=0;i<vapor.Length;i++)
