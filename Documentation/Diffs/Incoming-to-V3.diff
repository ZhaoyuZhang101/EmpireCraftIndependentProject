+            mesh=new Mesh{name="V3 local tangent patch",indexFormat=IndexFormat.UInt32};mesh.MarkDynamic();
+            go.GetComponent<MeshFilter>().sharedMesh=mesh;display=go.GetComponent<MeshRenderer>();
