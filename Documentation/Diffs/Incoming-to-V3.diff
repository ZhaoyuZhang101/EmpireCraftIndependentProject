+using System;
+using System.Collections.Generic;
+using UnityEngine;
+using UnityEngine.Rendering;
+
+namespace Orbis
+{
+    /// <summary>A local, uniformly sampled tangent patch over the SAME spherical height function.
+    /// Render vertices are not simulation tiles. No new tile IDs or duplicated world state.</summary>
+    public sealed class OrbisSurfaceLOD:MonoBehaviour
+    {
+        OrbisPlanetView view;
+        Mesh mesh;Material material;MeshRenderer display;
+        Vector3 center=Vector3.zero,right,north;float radius;
+        int resolution,lastRevision=-1,lastQuality=-1;
+        OrbisWorld lastWorld;
+        OrbisSphericalSampler.Sample[] samples;
+        Color[] colors;List<Vector4> climates,waters;
+        double nextRefresh;
