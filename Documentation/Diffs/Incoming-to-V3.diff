+                t.cloud=Coverage(qc);t.cloudRain=rain/dt;
+                // Visual/hydrological game proxy; not calibrated physical mm/month.
+                t.rain=Mathf.Lerp(t.rain,Mathf.Clamp(t.cloudRain*12000,0,1800),1-Mathf.Exp(-dt*.7f));
+            }
+        }
+    }
+}
