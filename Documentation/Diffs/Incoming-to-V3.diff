+#ifndef ORBIS_CLOUD_COMMON
+#define ORBIS_CLOUD_COMMON
+// Shared by view-ray clouds AND projected terrain/water shadows.
+// CloudState controls existence; immutable volume noise only controls small-scale shape.
+sampler2D _Weather, _CloudWind;
+sampler3D _CloudNoise;
+float _FlowPhase,_Cover,_Density,_Clouds;
+#define ORBIS_PI 3.14159265359
+#define ORBIS_CLOUD_BASE 1.085
+#define ORBIS_CLOUD_TOP 1.132
+#define ORBIS_EXTINCTION 105.0
+float2 OrbisWeatherUV(float3 p)
+{
+    p=normalize(p);
+    float longitude=abs(p.x)+abs(p.z)<1e-7?0.0:atan2(p.x,p.z);
+    return float2(longitude/(2.0*ORBIS_PI)+.5,asin(clamp(p.y,-1.0,1.0))/ORBIS_PI+.5);
+}
+float2 OrbisSphere(float3 origin,float3 direction,float radius)
+{
+    float b=dot(origin,direction),c=dot(origin,origin)-radius*radius;
+    float d=b*b-c;
+    if(d<0.0)return float2(1e8,-1e8);
+    float h=sqrt(max(0.0,d));return float2(-b-h,-b+h);
+}
+float OrbisSunVisible(float3 p,float3 sun)
+{
+    float2 hit=OrbisSphere(p+sun*.0002,sun,1.0);
+    return (hit.y>0.0 && hit.x>0.0)?0.0:1.0;
+}
+float OrbisNoiseAtAge(float3 p,float3 velocity,float age)
+{
+    float3 q=(p-velocity*(age*.014))*3.0+float3(.13,.71,.37);
+    float body=tex3Dlod(_CloudNoise,float4(q,0)).r;
+    float detail=tex3Dlod(_CloudNoise,float4(q*2.73,0)).g;
+    return body-(1.0-detail)*.13;
+}
+float OrbisCloudDensity(float3 p)
+{
+    float h=(length(p)-ORBIS_CLOUD_BASE)/(ORBIS_CLOUD_TOP-ORBIS_CLOUD_BASE);
+    if(h<=0.0 || h>=1.0)return 0.0;
+    float3 up=normalize(p);float2 uv=OrbisWeatherUV(up);
+    float4 state=tex2Dlod(_Weather,float4(uv,0,0));
+    float cover=saturate(state.r*_Cover)*_Clouds;
+    if(cover<.012)return 0.0;
+    float3 wind=(tex2Dlod(_CloudWind,float4(uv,0,0)).rgb-.5)*4.8;
+    wind-=up*dot(up,wind);
+    float pa=_FlowPhase,pb=frac(pa+.5);
+    float wa=.5-.5*cos(2.0*ORBIS_PI*pa);
+    float shape=lerp(OrbisNoiseAtAge(p,wind,(pb-.5)*12.0),OrbisNoiseAtAge(p,wind,(pa-.5)*12.0),wa);
+    float bottom=smoothstep(0.0,.12,h);
+    float top=1.0-smoothstep(lerp(.48,.70,state.b),1.0,h);
+    float threshold=.62-cover*.34;
+    return smoothstep(threshold,threshold+.19,shape)*cover*bottom*top*1.45*_Density;
+}
+float OrbisCloudShadow(float3 p,float3 sun)
+{
+    if(OrbisSunVisible(p,sun)<.5)return 1.0; // daylight lighting separately vanishes
+    float2 outer=OrbisSphere(p,sun,ORBIS_CLOUD_TOP);
+    float2 inner=OrbisSphere(p,sun,ORBIS_CLOUD_BASE);
