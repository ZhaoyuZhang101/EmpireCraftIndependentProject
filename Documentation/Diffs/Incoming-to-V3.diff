+        float drag=-wave*cs*weight*.38;
+        float3 gradDrag=wave*(sn-cs*cs)*gradPhase*weight*.38;
+        q+=direction*drag;jx+=direction*gradDrag.x;jy+=direction*gradDrag.y;jz+=direction*gradDrag.z;
