+#ifndef ORBIS_ATMOSPHERE_INTEGRATION
+#define ORBIS_ATMOSPHERE_INTEGRATION
+#include "UnityCG.cginc"
+#include "OrbisCloudCommon.cginc"
+sampler2D _MainTex;
+UNITY_DECLARE_DEPTH_TEXTURE(_CameraDepthTexture);
+float4 _MainTex_TexelSize;
+float3 _CameraLocal,_RayBL,_RayBR,_RayTL,_RayTR,_Sun;
+int _CloudSteps,_AirSteps,_LightSteps,_CloudDebug;
+float _CloudMS,_ScatteringStrength,_Night,_Atmosphere,_AirDensity,_Haze,_SolarEnergy;
+#define ORBIS_AIR_RADIUS 1.20
+// Independently written single-scattering integration following Dimev's explanatory model.
+// Reference: Dimas Leenman (2019), MIT; see Documentation/ThirdPartyNotices.md.
+// Game radius=1, deliberately exaggerated layer heights; this is not an Earth-calibrated atmosphere.
+float3 AirDensities(float3 p)
+{
+ float h=max(0.0,length(p)-1.0);
+ float ray=exp(-h/.025),mie=exp(-h/.006);
+ float ozone=ray/(1+pow((h-.06)/.012,2));
+ return float3(ray,mie,ozone)*_AirDensity*_Atmosphere;
+}
+float3 AirExtinction(float3 rho)
+{
+ return rho.x*float3(3.0,7.0,16.5)+rho.y*(_Haze*2.5)+rho.z*float3(2.04,4.97,.195);
+}
+float3 AirSunTransmittance(float3 p,float3 sun)
+{
+ if(OrbisSunVisible(p,sun)<.5)return 0;
+ float distance=max(0.0,OrbisSphere(p,sun,ORBIS_AIR_RADIUS).y);
+ float ds=distance/6;float3 tau=0;
+ [unroll] for(int k=0;k<6;k++)tau+=AirExtinction(AirDensities(p+sun*((k+.5)*ds)))*ds;
+ return exp(-min(tau,40.0));
+}
+   float HG(float cosine,float g)
+   {
+    return (1-g*g)/pow(max(.06,1+g*g-2*g*cosine),1.5);
+   }
+   float2 LightField(float3 p,float3 sun)
+   {
+    if(OrbisSunVisible(p,sun)<.5)return float2(0,0);
+    float lengthToExit=max(0.0,OrbisSphere(p,sun,ORBIS_CLOUD_TOP).y);
+    float ds=lengthToExit/max(1,_LightSteps);
+    float localTau[6];float totalTau=0;
+    [unroll] for(int j=0;j<6;j++)
+    {
+     float t=(j+.5)*ds;
+     localTau[j]=j<_LightSteps?OrbisCloudDensity(p+sun*t)*ORBIS_EXTINCTION*ds:0;
+     totalTau+=localTau[j];
+    }
+    float direct=exp(-min(totalTau,30.0));
+    if(_CloudMS<.5)return float2(direct,0);
+    // Reduced HP-inspired isotropic diffuse-source integral, NOT the author's full
+    // HDRP phi_fwd implementation. Attribution/derivation and scope in documentation.
+    // albedo=.999 -> sqrt(3*(1-albedo))=.05477 in isotropic optical-depth space.
+    float diffuse=0,travelTau=0;
+    [unroll] for(int k=0;k<6;k++)
+    {
+     if(k>=_LightSteps)break;
+     float entryTau=max(0.0,totalTau-travelTau-localTau[k]*.5);
+     float isotropization=1-exp(-.35*entryTau);
+     float absorption=exp(-.001*entryTau);
+     float kernel=exp(-.05477*(travelTau+localTau[k]*.5))/(1+(k+.5)*ds*22.0);
+     diffuse+=kernel*absorption*isotropization*localTau[k];
+     travelTau+=localTau[k];
+    }
+    float boundaryConfidence=saturate(lengthToExit/.015);
+    float thinSuppression=1-exp(-totalTau*1.2);
+    diffuse=min(1.4,diffuse*.28)*thinSuppression*boundaryConfidence;
+    return float2(direct,diffuse);
+   }
+
+struct OrbisVolumeResult {float3 light;float3 transmission;float sceneDepth;};
+float2 OrbisDepthUV(float2 uv)
+{
+ #if UNITY_UV_STARTS_AT_TOP
+ if(_MainTex_TexelSize.y<0)uv.y=1-uv.y;
+ #endif
+ return uv;
+}
+void IntegrateSegment(float3 ro,float3 rd,float begin,float end,int steps,bool hasCloud,inout OrbisVolumeResult result)
+{
