+using System;
+using System.Collections.Generic;
+using UnityEngine;
+using UnityEngine.Rendering;
+
+namespace Orbis
+{
+    /// <summary>A local, uniformly sampled tangent patch over the SAME spherical height function.
+    /// Render vertices are not simulation tiles. No new tile IDs or duplicated world state.</summary>
+    public sealed class OrbisSurfaceLOD:MonoBehaviour
+    {
+        OrbisPlanetView view;
+        Mesh mesh;Material material;MeshRenderer display;
+        Vector3 center=Vector3.zero,right,north;float radius;
+        int resolution,lastRevision=-1,lastQuality=-1;
+        OrbisWorld lastWorld;
+        OrbisSphericalSampler.Sample[] samples;
+        Color[] colors;List<Vector4> climates,waters;
+        double nextRefresh;
+        bool invalid=true;
+        public int VertexCount=>mesh?mesh.vertexCount:0;
+        public void Initialize(OrbisPlanetView source)
+        {
+            view=source;
+            var go=new GameObject("V3 local surface LOD",typeof(MeshFilter),typeof(MeshRenderer));go.transform.SetParent(transform,false);
+            mesh=new Mesh{name="V3 local tangent patch",indexFormat=IndexFormat.UInt32};mesh.MarkDynamic();
+            go.GetComponent<MeshFilter>().sharedMesh=mesh;display=go.GetComponent<MeshRenderer>();
+            material=new Material(view.SurfaceMaterial){name="V3 local terrain material"};display.sharedMaterial=material;
+            display.shadowCastingMode=ShadowCastingMode.On;display.enabled=false;
+        }
+        public void Invalidate(){invalid=true;}
+        public void Tick(double clock,Vector3 sun)
+        {
+            Vector3 camera=view.transform.InverseTransformPoint(view.viewCamera.transform.position);
+            Vector3 focus=camera.normalized;
+            float altitude=camera.magnitude-view.RadiusAt(focus);
+            bool active=view.world.settings.surfaceLOD&&altitude<.19f&&(view.layer==0||view.layer==1)&&!view.viewCamera.orthographic;
+            if(!active){display.enabled=false;view.SurfaceMaterial.SetFloat("_PatchActive",0);return;}
+            float desired=Mathf.Clamp(altitude*3.5f,.015f,.24f);
+            float size=Mathf.Min(.24f,.015f*Mathf.Pow(2,Mathf.Ceil(Mathf.Log(desired/.015f,2))));
+            int quality=Mathf.Clamp(view.world.settings.cloudQuality,0,3);
+            if(invalid||lastWorld!=view.world||lastRevision!=view.world.Revision||lastQuality!=quality||
+                Mathf.Abs(radius-size)>.0001f||Vector3.Angle(center,focus)*Mathf.Deg2Rad>size*.22f)
+            {
+                Build(focus,size,quality);invalid=false;lastWorld=view.world;lastRevision=view.world.Revision;lastQuality=quality;
+            }
+            view.BindSurfaceSettings(material,clock,sun);
+            foreach(Material m in new[]{view.SurfaceMaterial,material})
+            {
+                m.SetFloat("_PatchActive",1);m.SetVector("_PatchCenter",center);m.SetVector("_PatchRight",right);m.SetVector("_PatchUp",north);
+                m.SetFloat("_PatchRadius",radius);m.SetFloat("_LocalGrid",view.world.settings.localGrid?1:0);m.SetFloat("_GridSpacing",.0025f);
+            }
+            view.SurfaceMaterial.SetFloat("_PatchLayer",0);material.SetFloat("_PatchLayer",1);display.enabled=true;
+            if(clock>=nextRefresh){nextRefresh=clock+.3;RefreshColors();}
+        }
+        void Build(Vector3 at,float size,int quality)
+        {
+            // Parallel-transport the old horizontal axis when re-anchoring; no polar cross(up,n) singularity.
+            Vector3 oldRight=right;center=at;radius=size;
+            right=Vector3.ProjectOnPlane(oldRight,center);
+            if(right.sqrMagnitude<.01f)right=Vector3.Cross(Mathf.Abs(center.y)>.93f?Vector3.forward:Vector3.up,center);
+            right.Normalize();north=Vector3.Cross(center,right).normalized;
+            resolution=new[]{48,64,96,128}[quality];int row=resolution+1,count=row*row;
+            var vertices=new Vector3[count];var indices=new int[resolution*resolution*6];
+            samples=new OrbisSphericalSampler.Sample[count];colors=new Color[count];
+            climates=new List<Vector4>(new Vector4[count]);waters=new List<Vector4>(new Vector4[count]);
+            int hint=view.world.grid.Nearest(center);
+            for(int y=0;y<row;y++)for(int x=0;x<row;x++)
+            {
+                int i=y*row+x;float u=(2f*x/resolution-1)*radius,v=(2f*y/resolution-1)*radius;
+                Vector3 p=(center+right*u+north*v).normalized;
+                float r=view.RadiusAt(p,out samples[i],hint);hint=samples[i].a;vertices[i]=p*r;
+            }
+            int k=0;for(int y=0;y<resolution;y++)for(int x=0;x<resolution;x++)
+            {
+                int a=y*row+x;indices[k++]=a;indices[k++]=a+1;indices[k++]=a+row;
+                indices[k++]=a+1;indices[k++]=a+row+1;indices[k++]=a+row;
+            }
+            mesh.Clear();mesh.vertices=vertices;mesh.triangles=indices;mesh.RecalculateNormals();mesh.RecalculateBounds();RefreshColors();
+        }
+        public void RefreshColors()
+        {
+            if(samples==null||view==null)return;
+            for(int i=0;i<samples.Length;i++)
+            {
+                var s=samples[i];Vector3 w=s.weights;
+                colors[i]=view.GetTileColor(s.a)*w.x+view.GetTileColor(s.b)*w.y+view.GetTileColor(s.c)*w.z;
+                climates[i]=view.TileClimate(s.a)*w.x+view.TileClimate(s.b)*w.y+view.TileClimate(s.c)*w.z;
+                waters[i]=view.TileWater(s.a)*w.x+view.TileWater(s.b)*w.y+view.TileWater(s.c)*w.z;
+            }
+            mesh.colors=colors;mesh.SetUVs(1,climates);mesh.SetUVs(2,waters);
+        }
+        void OnDisable(){if(view!=null&&view.SurfaceMaterial)view.SurfaceMaterial.SetFloat("_PatchActive",0);if(display)display.enabled=false;}
+        void OnDestroy(){if(mesh)Destroy(mesh);if(material)Destroy(material);}
+    }
+}
