+ float phaseRay=3.0/(16.0*ORBIS_PI)*(1+mu*mu);
+ float phaseMie=(1-.7*.7)/(4*ORBIS_PI*pow(max(.02,1+.7*.7-2*.7*mu),1.5));
+ float phaseCloud=min(4.0,.82*HG(mu,.62)+.18*HG(mu,-.22));
