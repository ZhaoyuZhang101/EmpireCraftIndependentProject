+        }
+
+        void StepExpeditions(float days)
+        {
+            if (days <= 0) return;
+            expeditionClock += days;
+            if (settings.autoExpeditions && expeditionClock >= 45)
+            {
+                expeditionClock %= 45;
+                for (int c = 0; c < civs.Count; c++)
+                {
+                    int home = -1; float population = 350;
