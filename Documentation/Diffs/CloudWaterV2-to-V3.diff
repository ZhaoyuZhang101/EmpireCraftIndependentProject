+ {
+  if(j>=steps||max(result.transmission.r,max(result.transmission.g,result.transmission.b))<.002)break;
+  float3 p=ro+rd*(begin+(j+.5)*ds),rho=AirDensities(p);
+  float cloudDensity=hasCloud?OrbisCloudDensity(p):0;
+  float3 sigma=AirExtinction(rho)+cloudDensity*ORBIS_EXTINCTION;
+  if(max(sigma.r,max(sigma.g,sigma.b))<1e-6)continue;
+  float3 sunT=AirSunTransmittance(p,sun);
+  float3 source=(rho.x*float3(3,7,16.5)*phaseRay+rho.y*(_Haze*2.5)*phaseMie)*sunT*(8*max(.1,_SolarEnergy));
+  if(cloudDensity>.0005)
+  {
+   float2 fields=LightField(p,sun);
+   float3 direct=fields.x*phaseCloud*.70*sunT;
+   float3 multiple=fields.y*_CloudMS*_ScatteringStrength*sunT;
+   float3 radiance=direct+multiple+float3(.13,.19,.27)*OrbisSunVisible(p,sun)*.12;
+   if(_Night<.5)radiance=max(radiance,float3(.20,.23,.27));
+   if(_CloudDebug==1)radiance=cloudDensity.xxx;
+   if(_CloudDebug==2)radiance=direct;
+   if(_CloudDebug==3)radiance=multiple;
+   if(_CloudDebug==4)radiance=sunT;
+   if(_CloudDebug==5)radiance=float3(1-exp(-cloudDensity*3),cloudDensity*.3,.1);
+   source+=min(float3(5,5,5),radiance)*cloudDensity*ORBIS_EXTINCTION*max(.1,_SolarEnergy);
+  }
+  float3 stepT=exp(-min(sigma*ds,40.0));
+  result.light+=result.transmission*(source/max(sigma,1e-6))*(1-stepT);
+  result.transmission*=stepT;
+ }
+}
+OrbisVolumeResult OrbisMarch(float2 uv)
+{
