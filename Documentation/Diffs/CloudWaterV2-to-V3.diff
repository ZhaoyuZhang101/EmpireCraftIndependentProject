+using System.Collections.Generic;
+using UnityEngine;
+using UnityEngine.Rendering;
+
+namespace Orbis
+{
+    // An editable equirectangular atlas sharing the planet's authoritative Tile data.
+    // Seam-crossing quads are unwrapped and copied to both map edges.
+    public sealed class OrbisMapView : MonoBehaviour
+    {
+        Mesh mesh;
+        Material material;
+        OrbisWorld world;
+        OrbisPlanetView planetView;
+        int revision = -1;
+        int[] tileIds;
+        Vector3[] directions;
+        Color[] colors;
+        List<Vector4> climate;List<Vector4> water;
+        readonly List<Vector3> vertices = new List<Vector3>();
+
+        public static Vector3 Project(Vector3 p, float elevation = 0)
+        {
+            p.Normalize(); return new Vector3(-Mathf.Atan2(p.x, p.z), Mathf.Asin(Mathf.Clamp(p.y, -1, 1)), elevation * .12f);
+        }
+        public static Vector3 Unproject(Vector3 p)
+        {
+            float lat = Mathf.Clamp(p.y, -Mathf.PI / 2, Mathf.PI / 2);
+            return new Vector3(Mathf.Sin(-p.x) * Mathf.Cos(lat), Mathf.Sin(lat), Mathf.Cos(p.x) * Mathf.Cos(lat));
+        }
+        public void Initialize(OrbisWorld state, OrbisPlanetView view)
+        {
+            world = state; planetView = view;
+            material = new Material(Resources.Load<Shader>("ORBIS/Surface"));
+            material.SetTexture("_TerrainAtlas", Resources.Load<Texture2D>("ORBIS/TerrainAtlas"));
+            material.SetFloat("_Map", 1);view.Weather.Bind(material);
+            mesh = new Mesh { name = "世界展開圖", indexFormat = IndexFormat.UInt32 };
+            mesh.MarkDynamic();
+            gameObject.AddComponent<MeshFilter>().sharedMesh = mesh;
+            gameObject.AddComponent<MeshRenderer>().sharedMaterial = material;
+            Rebuild();
+        }
+        public void SetWorld(OrbisWorld state) { world = state; revision = -1; }
+        void Rebuild()
+        {
+            vertices.Clear();
+            var geo = new List<Vector3>(); var owners = new List<int>(); var triangles = new List<int>();
+            for (int i = 0; i < world.tiles.Length; i++)
+            {
+                int[] ids = world.grid.tileCorners[i];
+                var p = new Vector3[4];
+                float reference = Project(world.grid.points[i]).x;
+                float min = 100, max = -100;
+                for (int k = 0; k < 4; k++)
+                {
+                    p[k] = Project(world.grid.corners[ids[k]]);
+                    if(Mathf.Abs(world.grid.corners[ids[k]].y)>.999999f)p[k].x=reference;
+                    p[k].x += Mathf.Round((reference - p[k].x) / (2 * Mathf.PI)) * (2 * Mathf.PI);
+                    min = Mathf.Min(min, p[k].x); max = Mathf.Max(max, p[k].x);
+                }
+                AddQuad(i, ids, p, 0, geo, owners, triangles);
+                if (min < -Mathf.PI) AddQuad(i, ids, p, 2 * Mathf.PI, geo, owners, triangles);
+                if (max > Mathf.PI) AddQuad(i, ids, p, -2 * Mathf.PI, geo, owners, triangles);
+            }
+            mesh.Clear(); mesh.SetVertices(vertices); mesh.SetTriangles(triangles, 0);
+            mesh.SetUVs(0, geo); mesh.normals = geo.ToArray(); mesh.RecalculateBounds();
+            tileIds = owners.ToArray(); directions = geo.ToArray(); colors = new Color[tileIds.Length];
+            climate = new List<Vector4>(new Vector4[tileIds.Length]);water=new List<Vector4>(new Vector4[tileIds.Length]);
+            revision = world.Revision; Refresh();
+        }
+        void AddQuad(int tile, int[] corners, Vector3[] p, float offset, List<Vector3> geo, List<int> owners, List<int> triangles)
+        {
+            int n=vertices.Count;
+            for(int k=0;k<4;k++)
+            {
+                Vector3 direction=world.grid.corners[corners[k]];
+                if(Mathf.Abs(direction.y)>.999999f)
+                {
+                    // A single spherical pole expands to an edge in a longitude/latitude atlas.
+                    vertices.Add(new Vector3(p[(k+3)%4].x+offset,p[k].y,0));geo.Add(direction);owners.Add(tile);
+                    vertices.Add(new Vector3(p[(k+1)%4].x+offset,p[k].y,0));geo.Add(direction);owners.Add(tile);
+                }
+                else {vertices.Add(p[k]+Vector3.right*offset);geo.Add(direction);owners.Add(tile);}
+            }
+            for(int k=n+1;k+1<vertices.Count;k++)triangles.AddRange(new[]{n,k,k+1});
+        }
+
+        public void Refresh()
+        {
+            if (world == null) return;
+            if (revision != world.Revision) { Rebuild(); return; }
+            for (int i = 0; i < tileIds.Length; i++)
+            {
+                int tile = tileIds[i]; Tile t = world.tiles[tile];
+                colors[i] = planetView.GetTileColor(tile);water[i]=planetView.TileWater(tile);
+                climate[i] = new Vector4(t.soil, Mathf.Clamp01(t.snow / 30), Mathf.InverseLerp(.4f, .95f, t.h), 1);
+            }
+            mesh.colors = colors; mesh.SetUVs(1, climate);mesh.SetUVs(2,water);
+            material.SetVector("_Sun", world.SunLocal); material.SetFloat("_Night", world.settings.night ? 1 : 0);
+            material.SetFloat("_Natural", planetView.layer == 0 ? 1 : 0);
+            material.SetFloat("_Clock", world.weatherClock); material.SetFloat("_WaterRoughness", world.settings.waterRoughness);
+            material.SetFloat("_SurfaceDetail", world.settings.surfaceDetail);
+        }
+        public void Sync(double clock,Vector3 sun,float interpolation)
+        {
+            planetView.BindSurfaceSettings(material,clock,sun,true);material.SetFloat("_PatchActive",0);
+        }
+        void OnDestroy() { if (mesh) Destroy(mesh); if (material) Destroy(material); }
+    }
+}
