<Project Sdk="Microsoft.NET.Sdk">
  <!-- EmpireCraft core checks in plain .NET: the same sources Unity compiles in
       EmpireCraft.Core and Orbis.Flat.Core, without any engine reference. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><LangVersion>9.0</LangVersion><EnableDefaultCompileItems>false</EnableDefaultCompileItems><Nullable>disable</Nullable><Optimize>true</Optimize></PropertyGroup>
  <!-- Unity resolves Newtonsoft.Json from com.unity.nuget.newtonsoft-json (13.0.x). -->
  <ItemGroup><PackageReference Include="Newtonsoft.Json" Version="13.0.3"/></ItemGroup>
  <ItemGroup>
    <Compile Include="../../Assets/ORBIS/Runtime/FlatWorld/Core/*.cs"/>
    <Compile Include="../../Assets/EmpireCraft/Core/**/*.cs"/>
    <Compile Include="*.cs"/>
  </ItemGroup>
</Project>
