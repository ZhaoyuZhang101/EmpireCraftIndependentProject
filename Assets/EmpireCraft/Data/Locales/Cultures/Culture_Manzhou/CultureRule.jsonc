{
    "name": "Manzhou",
    "color": "#856100",
    "translate_cz": "女真",
    "translate_ch": "女真",
    // 故土(独立游戏用，模组不读)：开局按地理分区给各国定民族时，按这里的气候、纬度等与地区比合不合；没有这一段的文化开局不落地(留给剧本)
    "homeland": {
        "climates": ["Dwb", "Dwa", "Dfb", "Dwc", "Dfa"], // 柯本气候
        "latitude": 47, // 故土的纬度(南北都按绝对值)
        "spread": 7, // 离这个纬度多远还算合
        "side": "east", // 在大陆的东侧 east / 西侧 west
        "earth": [118, 135, 41, 54], // 地球图上的故土：西界、东界经度(西经为负)，南界、北界纬度(南纬为负)
        "earth_priority": 3 // 地球图上几个故土相叠时，数小的先算
    },
    "setting": {
        // 默认游牧(用户 2026-11-06)；游牧线的千户制在女真叫猛安谋克，后接只给 banner 特性的八旗制度(见 BannerSystem)
        "regime": "YouMu",
        "institution_line": "Youmu",
