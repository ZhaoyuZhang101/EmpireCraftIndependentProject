{
    "name": "Roma",
    "color": "#7B2D26",
    "translate_cz": "罗马",
    // 故土(独立游戏用，模组不读)：开局按地理分区给各国定民族时，按这里的气候、纬度等与地区比合不合；没有这一段的文化开局不落地(留给剧本)
    "homeland": {
        "climates": ["Csa", "Csb"], // 柯本气候
        "latitude": 40, // 故土的纬度(南北都按绝对值)
        "spread": 6, // 离这个纬度多远还算合
        "coast": true, // 滨海
        "earth": [-10, 44, 34, 46], // 地球图上的故土：西界、东界经度(西经为负)，南界、北界纬度(南纬为负)
        "earth_priority": 13 // 地球图上几个故土相叠时，数小的先算
    },
    "setting": {
        "regime": "Feudalism",
        "institution_line": "Roma",
        "tianxia": "Roma",
        // 宪法：名称词库(name_group / provisional_name_group)与本文化的制宪倾向(clauses，覆盖各党主张)
        "Constitution": {
            "clauses": { "territory": "Unitary" }
        },
        // 现代政权称呼(见 Locales/Cultures/README.md 政党一节)：未组建政府的势力 / 临时政府；没配的理念用默认称呼
        "Party": {
            "untitled_groups": {
                "SocialLiberalism": "UntitledSocialLiberalism",
                "Communism": "UntitledCommunism"
            },
            "provisional_groups": {
                "SocialDemocracy": "ProvisionalSocialDemocracy"
            }
        },
        "traits": ["patriarchy"],
        // 无人区命名(见 Locales/Cultures/README.md 无人区一节)：地名 + 类型后缀，拉丁地名：Mons Apenninus、格德罗西亚沙漠、许珀耳玻瑞亚冻原、赫西尼亚密林、蓬蒂内沼泽
        "Wilderness": {
            "words": { "mountain": "WildMountain", "desert": "WildDesert", "tundra": "WildTundra", "jungle": "WildJungle", "swamp": "WildSwamp" },
            "suffix": { "mountain": "WildMountainSuffix", "jungle": "WildJungleSuffix" }
        },
        "City": {
            "groups": {
                "group_1": "CityNames1"
            },
            "rule": [ "group_1" ],
            "name_pos": 0
        },
        "Clan": {
            "groups": {
                "group_1": "ClanNames",
                "group_2": "\u200A",
                "group_3": "Clan"
            },
            "rule": [ "group_1", "group_2", "group_3" ],
            "name_pos": 0,
            "has_sex_post": false,
            "use_local_as_lastname": false,
            "sex_post_Male": ["", "", ""],
            "sex_post_Female": ["", "", ""]
        },
        "Family": {
            "groups": {
                "group_1": "FamilyNames",
                "group_2": "\u200A",
                "group_3": "Family"
            },
            "rule": [ "group_1", "group_2", "group_3" ],
            "name_pos": 0,
            "has_sex_post": false,
            "use_local_as_lastname": false
        },
        "Unit": {
            "groups": {
                "group_1": "UnitNamesMale1",
                "group_2": "UnitNamesFemale1"
            },
            "rule": [
                "group_1",
                "sex_male",
                "group_2",
                "sex_female",
                "space"
            ],
            "name_pos": 0,
            "is_invert": true

        },
        "Kingdom": {
            "groups": {
                "group_1": "CountryNames"
            },
            "rule": [ "group_1" ],
            "name_pos": 0
        }
    },
    "beaurau_config": {
        "CoreOffice": [],
        "Divisions": []
    }
}
