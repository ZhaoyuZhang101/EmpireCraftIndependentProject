{
    "name": "Arab",
    "color": "#1E8449",
    "translate_cz": "阿拉伯",
    // 故土(独立游戏用，模组不读)：开局按地理分区给各国定民族时，按这里的气候、纬度等与地区比合不合；没有这一段的文化开局不落地(留给剧本)
    "homeland": {
        "climates": ["BWh", "BSh"], // 柯本气候
        "latitude": 23, // 故土的纬度(南北都按绝对值)
        "spread": 8, // 离这个纬度多远还算合
        "earth": [33, 60, 12, 37], // 地球图上的故土：西界、东界经度(西经为负)，南界、北界纬度(南纬为负)
        "earth_priority": 9 // 地球图上几个故土相叠时，数小的先算
    },
    "setting": {
        "regime": "Arabic",
        "institution_line": "Arabic",
        "political_traits": ["dry_native"],
        "tianxia": "Umma",
        // 宪法：名称词库(name_group / provisional_name_group)与本文化的制宪倾向(clauses，覆盖各党主张)
        "Constitution": {
            "clauses": { "religion": "StateReligion" }
        },
        // 现代政权称呼(见 Locales/Cultures/README.md 政党一节)：未组建政府的势力 / 临时政府；没配的理念用默认称呼
        "Party": {
            "untitled_groups": {
                "Centrism": "UntitledCentrism",
                "Socialism": "UntitledSocialism",
                "ReligiousDemocracy": "UntitledReligiousDemocracy",
                "Authoritarianism": "UntitledAuthoritarianism",
                "Conservatism": "UntitledConservatism"
            }
        },
        "traits": ["patriarchy"],
        // 无人区命名(见 Locales/Cultures/README.md 无人区一节)：地名 + 类型后缀，希贾兹山脉、鲁卜哈利沙漠、巴塔伊赫沼泽；冻原取伊本·法德兰笔下的北方(不里阿耳、黑暗之地)
        "Wilderness": {
            "words": { "mountain": "WildMountain", "desert": "WildDesert", "tundra": "WildTundra", "jungle": "WildJungle", "swamp": "WildSwamp" }
        },
        "City": {
            "groups": {
                "group_1": "CityNames1",
                "group_2": "CityNames2"
            },
            "rule": [ "group_1", "coin_flip", "group_2" ],
            "name_pos": 0
        },
        "Clan": {
            "groups": {
                "group_1": "ClanNames1",
                "group_2": "ClanNames2",
                "group_3": "Clan",
                "group_4": "\u200A"
            },
            "rule": [ "group_1", "coin_flip", "group_2", "group_4", "group_3" ],
            "name_pos": 0,
            "has_sex_post": false,
            "use_local_as_lastname": false,
            "sex_post_Male": ["", "", ""],
            "sex_post_Female": ["", "", ""]
        },
        "Family": {
            "groups": {
                "group_1": "ClanNames1",
                "group_2": "ClanNames2",
                "group_3": "Family",
                "group_4": "\u200A"
            },
            "rule": [ "group_1", "coin_flip", "group_2", "group_4", "group_3" ],
            "name_pos": 0,
            "has_sex_post": false,
            "use_local_as_lastname": false
        },
        "Unit": {
            "groups": {
                "group_1": "UnitNamesMale1",
                "group_2": "UnitNamesFemale1"
            },
            "rule": [
                "group_1",
                "sex_male",
                "group_2",
                "sex_female",
                "space"
            ],
            "name_pos": 0,
            "is_invert": true
        },
        "Kingdom": {
            "groups": {
                "group_1": "CountryNames1",
                "group_2": "CountryNames2"
            },
            "rule": [ "group_1", "coin_flip", "group_2" ],
            "name_pos": 0
        }
    },
    "beaurau_config": {
        "CoreOffice": [],
        "Divisions": []
    }
}
