{
    "name": "Swahili",
    "color": "#4B2350",
    "translate_cz": "斯瓦希里",
    // 故土(独立游戏用，模组不读)：开局按地理分区给各国定民族时，按这里的气候、纬度等与地区比合不合；没有这一段的文化开局不落地(留给剧本)
    "homeland": {
        "climates": ["Aw", "Am", "Af"], // 柯本气候
        "latitude": 6, // 故土的纬度(南北都按绝对值)
        "spread": 8, // 离这个纬度多远还算合
        "side": "east", // 在大陆的东侧 east / 西侧 west
        "coast": true, // 滨海
        "southern": true, // 在南半球
        "earth": [34, 45, -12, 5], // 地球图上的故土：西界、东界经度(西经为负)，南界、北界纬度(南纬为负)
        "earth_priority": 10 // 地球图上几个故土相叠时，数小的先算
    },
    "setting": {
        "regime": "Origin",
        "institution_line": "Arabic",
        // 法教传统(dharmic)是印度的；斯瓦希里奉伊斯兰、走阿拉伯线，不带它才有哈里发册封、天课与圣战
