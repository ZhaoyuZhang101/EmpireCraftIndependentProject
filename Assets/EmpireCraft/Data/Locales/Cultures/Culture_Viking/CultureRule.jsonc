{
    "name": "Viking",
    "color": "#4682B4",
    "translate_cz": "维京",
    // 故土(独立游戏用，模组不读)：开局按地理分区给各国定民族时，按这里的气候、纬度等与地区比合不合；没有这一段的文化开局不落地(留给剧本)
    "homeland": {
        "climates": ["Dfc", "Cfc", "ET", "Dfb"], // 柯本气候
        "latitude": 62, // 故土的纬度(南北都按绝对值)
        "spread": 7, // 离这个纬度多远还算合
        "coast": true, // 滨海
        "earth": [4, 32, 55, 72], // 地球图上的故土：西界、东界经度(西经为负)，南界、北界纬度(南纬为负)
        "earth_priority": 16 // 地球图上几个故土相叠时，数小的先算
    },
    "setting": {
        "regime": "Feudalism",
        "institution_line": "Roma",
        "tianxia": "Roma",
        // 现代政权称呼(见 Locales/Cultures/README.md 政党一节)：未组建政府的势力 / 临时政府；没配的理念用默认称呼
        "Party": {
            "untitled_groups": {
                "SocialDemocracy": "UntitledSocialDemocracy",
                "Conservatism": "UntitledConservatism",
                "Fascism": "UntitledFascism"
            }
        },
        "traits": ["patriarchy"],
        // 劫掠传统(领主派可提劫掠)，见 Locales/Cultures/README.md
        "political_traits": ["raider"],
        // 村镇命名(见 Locales/Cultures/README.md 村镇一节)：姓氏(托斯比)、字库(希尔斯比村)；关城用姓氏(托斯堡)
        "Settlement": {
            "village_modes": { "surname": 2, "words": 1 },
            "town_modes": { "words": 1 },
            "fort_modes": { "surname": 1 },
            "village_words": "VillageNames",
            "village_suffix": "Western:VillageSuffix",
            "surname_suffix": "SurnameSuffix",
            "town_words": "VillageNames",
            "town_suffix": "TownSuffix",
            "fort_suffix": "FortSuffix"
        },
        // 无人区命名(见 Locales/Cultures/README.md 无人区一节)：地名 + 类型后缀，约顿海门山脉、斯普伦吉桑迪沙原、尼弗尔海姆、文兰雨林、维尔德莫斯沼泽
        "Wilderness": {
            "words": { "mountain": "WildMountain", "desert": "WildDesert", "tundra": "WildTundra", "jungle": "WildJungle", "swamp": "WildSwamp" },
            "suffix": { "desert": "WildDesertSuffix" }
        },
        "City": {
            "groups": {
                "group_1": "CityNames1",
                "group_2": "CityNames2",
                "group_3": "\u200A",
                "group_4": "CityNames3"
            },
            "rule": [ "group_1", "group_3", "group_2", "group_4" ],
            "name_pos": 0
        },
        "Clan": {
            "groups": {
                "group_1": "ClanNames",
                "group_2": "Clan",
                "group_3": "\u200A"
            },
            "rule": [
                "group_1",
                "group_3",
                "group_2"
            ],
            "name_pos": 0,
            "has_sex_post": true,
            "use_local_as_lastname": false,
            "sex_post_Male": ["之子", "son", "之子"],
            "sex_post_Female": ["之女", "dóttir", "之女"]
        },
        "Family": {
            "groups": {
                "group_1": "FamilyNames",
                "group_2": "Family",
                "group_3": "\u200A"
            },
            "rule": [ "group_1", "group_3", "group_2" ],
            "name_pos": 0,
            "has_sex_post": true,
            "use_local_as_lastname": false
        },
        "Unit": {
            "groups": {
                "group_1": "UnitNamesMale1",
                "group_2": "UnitNamesFemale1",
                "group_3": "UnitNickNames"
            },
            "rule": [
                "group_3",
                "coin_flip",
                "group_1",
                "sex_male",
                "group_2",
                "sex_female",
                "space"
            ],
            "name_pos": 0,
            "is_invert": true
        },
        "Kingdom": {
            "groups": {
                "group_1": "CountryNames1",
                "group_2": "CountryNames2"
            },
            "rule": [ "group_1", "group_2" ],
            "name_pos": 0
        }
    },
    "beaurau_config": {
        "CoreOffice": [],
        "Divisions": []
    }
}
