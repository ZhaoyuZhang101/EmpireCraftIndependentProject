{
    "name": "Xizang",
    "color": "#00995E",
    "translate_cz": "青藏",
    // 故土(独立游戏用，模组不读)：开局按地理分区给各国定民族时，按这里的气候、纬度等与地区比合不合；没有这一段的文化开局不落地(留给剧本)
    "homeland": {
        "climates": ["ET", "Dwc", "Cwc", "BWk"], // 柯本气候
        "latitude": 33, // 故土的纬度(南北都按绝对值)
        "spread": 8, // 离这个纬度多远还算合
        "height": 3000, // 高原民族：故土的海拔(米)
        "earth": [78, 100, 27, 37], // 地球图上的故土：西界、东界经度(西经为负)，南界、北界纬度(南纬为负)
        "earth_priority": 4 // 地球图上几个故土相叠时，数小的先算
    },
    "setting": {
        // 兜底政体(游牧线读不到时、复辟找不到君主制时才看)：各文化共用的原始政体；以前写成华夏原始政体(华夏上古的禅让部落联盟)，与青藏不合
