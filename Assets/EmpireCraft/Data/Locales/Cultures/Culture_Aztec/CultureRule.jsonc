{
    "name": "Aztec",
    "color": "#E67E22",
    "translate_cz": "阿兹特克",
    // 故土(独立游戏用，模组不读)：开局按地理分区给各国定民族时，按这里的气候、纬度等与地区比合不合；没有这一段的文化开局不落地(留给剧本)
    "homeland": {
        "climates": ["Aw", "Cwb", "BSh"], // 柯本气候
        "latitude": 20, // 故土的纬度(南北都按绝对值)
        "spread": 6, // 离这个纬度多远还算合
        "height": 1500, // 高原民族：故土的海拔(米)
        "earth": [-118, -86, 14, 33], // 地球图上的故土：西界、东界经度(西经为负)，南界、北界纬度(南纬为负)
        "earth_priority": 18 // 地球图上几个故土相叠时，数小的先算
    },
    "setting": {
        "regime": "Origin",
        "institution_line": "Origins",
        // 天下标识(用户 2026-10-21 定"补天下标识")：本文化自成一个天下；明写了，相邻的同文化帝国法理才会自动并成一个天下
        // (没写的一个帝国法理一个天下，常常凑不满 8 城、没有天命，见 TianxiaSystem.AutoArrange)
        "tianxia": "Aztec",
        // 现代政权称呼(见 Locales/Cultures/README.md 政党一节)：未组建政府的势力 / 临时政府；没配的理念用默认称呼
        "Party": {
            "untitled_groups": {
                "Libertarianism": "UntitledLibertarianism",
                "SocialLiberalism": "UntitledSocialLiberalism",
                "Centrism": "UntitledCentrism",
                "Socialism": "UntitledSocialism",
                "ReligiousDemocracy": "UntitledReligiousDemocracy"
            }
        },
        "traits": ["patriarchy"],
        // 无人区命名(见 Locales/Cultures/README.md 无人区一节)：地名 + 类型后缀，马德雷山脉、奇奇梅卡沙漠、米克特兰冻原、尤卡坦雨林、特斯科科沼泽
        "Wilderness": {
            "words": { "mountain": "WildMountain", "desert": "WildDesert", "tundra": "WildTundra", "jungle": "WildJungle", "swamp": "WildSwamp" }
        },
        "City": {
            "groups": {
                "group_1": "CityNames1",
                "group_2": "CityNames2"
            },
            "rule": [ "group_1", "group_2", "group_3" ],
            "name_pos": 0
        },
        "Clan": {
            "groups": {
                "group_1": "ClanNames",
                "group_2": "\u200A",
                "group_3": "Clan"
            },
            "rule": [
                "group_1",
                "group_2"
            ],
            "name_pos": 0,
            "has_sex_post": true,
            "use_local_as_lastname": false,
            "sex_post_Male": ["之子","tzin","之子"],
            "sex_post_Female": ["之女","tzin","之女"]
        },
        "Family": {
            "groups": {
                "group_1": "FamilyNames",
                "group_2": "\u200A",
                "group_3": "Family"
            },
            "rule": [ "group_1", "group_2", "group_3" ],
            "name_pos": 0,
            "has_sex_post": true,
            "use_local_as_lastname": false
        },
        "Unit": {
            "groups": {
                "group_1": "UnitNamesMale1",
                "group_2": "UnitNamesFemale1"
            },
            "rule": [
                "group_1",
                "sex_male",
                "group_2",
                "sex_female",
                "space"
            ],
            "name_pos": 0,
            "is_invert": false
        },
        "Kingdom": {
            "groups": {
                "group_1": "CountryNames"
            },
            "rule": [ "group_1" ],
            "name_pos": 0
        }
    },
    "beaurau_config": {
        "CoreOffice": [],
        "Divisions": []
    }
}
