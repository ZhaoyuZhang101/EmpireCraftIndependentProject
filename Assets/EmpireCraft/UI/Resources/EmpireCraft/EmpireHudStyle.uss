/* EmpireCraft civilization HUD. Reference resolution 1440 x 900 (OrbisPanel).
   Three themes are root classes: .theme-star 星图青铜, .theme-atlas 舆图羊皮, .theme-slate 石青白玉.
   Pixel frames are 48 px textures with 14 px nine-slice corners; edges and centre are
   tiled so the period-4 ornaments never smear. Icons are 28 px pixel art shown at 1x
   (bars, rail) or 2x (tool grid). */

/* ---------- theme tokens ---------- */
.theme-star {
    --ec-gold: rgb(233, 200, 120); --ec-cyan: rgb(132, 214, 232); --ec-grey: rgb(139, 160, 174);
    --ec-val: rgb(238, 242, 244); --ec-sub: rgb(185, 198, 206); --ec-title: rgb(29, 42, 54);
    --ec-ins: rgb(13, 20, 27); --ec-line: rgb(42, 58, 72); --ec-page: rgb(11, 16, 22);
}
.theme-atlas {
    --ec-gold: rgb(240, 208, 138); --ec-cyan: rgb(232, 149, 122); --ec-grey: rgb(184, 166, 138);
    --ec-val: rgb(246, 238, 220); --ec-sub: rgb(216, 200, 168); --ec-title: rgb(74, 58, 40);
    --ec-ins: rgb(44, 35, 24); --ec-line: rgb(90, 74, 52); --ec-page: rgb(26, 20, 14);
}
.theme-slate {
    --ec-gold: rgb(230, 217, 168); --ec-cyan: rgb(124, 210, 170); --ec-grey: rgb(154, 168, 180);
    --ec-val: rgb(238, 241, 243); --ec-sub: rgb(190, 200, 207); --ec-title: rgb(42, 52, 64);
    --ec-ins: rgb(21, 28, 35); --ec-line: rgb(54, 66, 78); --ec-page: rgb(15, 20, 25);
}

/* ---------- frames ---------- */
.ec-frame {
    -unity-slice-left: 14; -unity-slice-right: 14; -unity-slice-top: 14; -unity-slice-bottom: 14;
    -unity-slice-type: tiled;
    padding: 8px;
}
.theme-star .ec-frame { background-image: resource("EmpireCraft/Frames/Frame2_star"); }
.theme-star .ec-frame.ec-on { background-image: resource("EmpireCraft/Frames/Frame2_star_dominate"); }
.theme-star .ec-frame.ec-sel { background-image: resource("EmpireCraft/Frames/Frame2_star_select"); }
.theme-atlas .ec-frame { background-image: resource("EmpireCraft/Frames/Frame2_atlas"); }
.theme-atlas .ec-frame.ec-on { background-image: resource("EmpireCraft/Frames/Frame2_atlas_dominate"); }
.theme-atlas .ec-frame.ec-sel { background-image: resource("EmpireCraft/Frames/Frame2_atlas_select"); }
.theme-slate .ec-frame { background-image: resource("EmpireCraft/Frames/Frame2_slate"); }
.theme-slate .ec-frame.ec-on { background-image: resource("EmpireCraft/Frames/Frame2_slate_dominate"); }
.theme-slate .ec-frame.ec-sel { background-image: resource("EmpireCraft/Frames/Frame2_slate_select"); }

/* ---------- ORBIS shell while the HUD is on ---------- */
.ec-hud-on .header, .ec-hud-on .sidebar, .ec-hud-on .footer { display: none; }
.ec-hud-on .viewport { left: 0; right: 0; top: 0; bottom: 0; }
.ec-hud-on .minimap-frame {
    right: 12px; bottom: 12px; padding: 8px; border-width: 0; background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 14; -unity-slice-right: 14; -unity-slice-top: 14; -unity-slice-bottom: 14; -unity-slice-type: tiled;
}
.theme-star.ec-hud-on .minimap-frame { background-image: resource("EmpireCraft/Frames/Frame2_star"); }
.theme-atlas.ec-hud-on .minimap-frame { background-image: resource("EmpireCraft/Frames/Frame2_atlas"); }
.theme-slate.ec-hud-on .minimap-frame { background-image: resource("EmpireCraft/Frames/Frame2_slate"); }
.ec-hud-on .map-scale { left: auto; right: 276px; bottom: 16px; }
/* classic ORBIS sidebar as a drawer, opened from the world window */
.ec-hud-on.ec-classic .sidebar {
    display: flex; left: 98px; top: 66px; bottom: 12px; width: 300px;
    border-width: 1px; border-color: var(--ec-line);
}

/* ---------- base ---------- */
.ec-hud { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: var(--ec-val); font-size: 13px; }
.ec-hidden { display: none; }
.ec-icon { width: 28px; height: 28px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.ec-icon.ec-x2 { width: 56px; height: 56px; }
.ec-icon.ec-sm { width: 20px; height: 20px; }
.ec-label { color: var(--ec-sub); -unity-text-align: middle-center; white-space: nowrap; }
.ec-click:hover > .ec-label { color: var(--ec-val); }
.ec-on > .ec-label { color: var(--ec-gold); -unity-font-style: bold; }
.ec-sel > .ec-label { color: var(--ec-cyan); -unity-font-style: bold; }
.ec-off { opacity: 0.42; }
.ec-off > .ec-icon { -unity-background-image-tint-color: rgb(170, 170, 170); }
.ec-off:hover > .ec-label { color: var(--ec-sub); }

/* card header */
.ec-ch {
    flex-direction: row; align-items: center; flex-shrink: 0;
    border-bottom-width: 1px; border-bottom-color: var(--ec-line); padding-bottom: 3px; margin-bottom: 4px;
}
.ec-ch > .ec-icon { margin-right: 5px; }
.ec-ch-title { color: var(--ec-gold); -unity-font-style: bold; font-size: 14px; }
.ec-ch-note { margin-left: auto; color: var(--ec-sub); font-size: 11px; }
.ec-hint { color: var(--ec-grey); font-size: 11px; white-space: normal; margin-top: 5px; }

/* ---------- top bar ---------- */
.ec-era { position: absolute; left: 8px; top: 8px; height: 56px; flex-direction: row; align-items: center; padding: 4px 8px 4px 12px; }
.ec-era-text { margin-right: 10px; }
.ec-date { color: var(--ec-gold); -unity-font-style: bold; font-size: 15px; margin: 0; padding: 0; }
.ec-date-sub { color: var(--ec-sub); font-size: 11px; margin: 0; padding: 0; }
.ec-ctl { flex-direction: row; }
.ec-ib { flex-direction: row; align-items: center; justify-content: center; min-width: 40px; height: 34px; padding: 4px 8px; margin-left: 3px; }
.ec-ib > .ec-label { font-size: 13px; }

.ec-modes { position: absolute; left: 50%; translate: -50% 0; top: 8px; flex-direction: row; padding: 6px; }
.ec-mode { flex-direction: row; align-items: center; height: 44px; padding: 6px 14px 6px 10px; margin: 0 2px; }
.ec-mode > .ec-icon { margin-right: 5px; }
.ec-mode > .ec-label { font-size: 15px; }

.ec-views { position: absolute; right: 8px; top: 8px; flex-direction: row; align-items: center; padding: 6px; }
.ec-vbtn { flex-direction: row; align-items: center; height: 40px; padding: 5px 10px 5px 7px; margin: 0 2px; }
.ec-vbtn > .ec-icon { margin-right: 4px; }
.ec-vbtn.ec-iconly { padding: 5px 7px; }
.ec-vbtn.ec-iconly > .ec-icon { margin-right: 0; }

/* ---------- category rail + popout grid ---------- */
.ec-rail { position: absolute; left: 8px; top: 66px; width: 84px; padding: 7px; }
.ec-cat { align-items: center; padding: 7px 2px 6px 2px; margin-bottom: 2px; }
.ec-cat > .ec-label { font-size: 12px; margin-top: 1px; }

.ec-pop { position: absolute; left: 98px; top: 66px; width: 384px; padding: 9px 10px 10px 10px; }
.ec-grid { flex-direction: row; flex-wrap: wrap; }
.ec-tool { width: 86px; height: 96px; align-items: center; justify-content: center; padding: 6px 2px; margin: 0 3px 3px 0; }
.ec-tool > .ec-label { font-size: 12px; margin-top: 2px; }
.ec-tool.ec-opener > .ec-label { color: var(--ec-gold); }

/* ---------- tile card ---------- */
.ec-info { position: absolute; right: 8px; top: 66px; width: 304px; max-height: 600px; padding: 9px 10px 10px 10px; }
.ec-info-rows { flex-shrink: 1; min-height: 0; }
.ec-row { flex-direction: row; align-items: center; padding: 2px 5px; min-height: 20px; }
.ec-row.ec-alt { background-color: var(--ec-ins); }
.ec-row-key { color: var(--ec-grey); font-size: 12px; min-width: 86px; }
.ec-row-val { color: var(--ec-val); font-size: 12px; white-space: normal; flex-shrink: 1; margin-left: auto; -unity-text-align: middle-right; }
.ec-btns { flex-direction: row; margin-top: 6px; flex-shrink: 0; }
.ec-btn { flex-grow: 1; flex-direction: row; align-items: center; justify-content: center; height: 34px; padding: 4px 8px; margin-right: 3px; }
.ec-btn > .ec-label { font-size: 12px; }

/* ---------- chronicle, legend, brush ---------- */
.ec-feed { position: absolute; left: 98px; bottom: 8px; width: 430px; padding: 9px 10px 8px 10px; }
.ec-feed .ec-row-key { min-width: 76px; font-size: 11px; }
.ec-feed .ec-row-val { margin-left: 0; -unity-text-align: middle-left; flex-grow: 1; }
.ec-legend { position: absolute; left: 98px; bottom: 176px; width: 270px; padding: 9px 10px; }
.ec-legend-text { color: var(--ec-sub); font-size: 11px; white-space: normal; margin-top: 3px; }
.ec-brush { position: absolute; left: 540px; bottom: 8px; flex-direction: row; align-items: center; padding: 6px 10px; }
.ec-brush-lab { color: var(--ec-grey); font-size: 12px; margin: 0 6px 0 4px; }
.ec-chip { flex-direction: row; align-items: center; height: 34px; padding: 4px 9px; margin-right: 2px; }
.ec-chip > .ec-label { font-size: 12px; }

/* ---------- 卷册 wide window ---------- */
.ec-window-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.38); }
.ec-win { position: absolute; left: 50%; translate: -50% 0; top: 62px; width: 900px; height: 640px; padding: 8px; }
.ec-win-tb {
    height: 34px; flex-shrink: 0; flex-direction: row; align-items: center; justify-content: center;
    background-color: var(--ec-title); border-bottom-width: 2px; border-bottom-color: var(--ec-ins);
}
.ec-win-title { color: var(--ec-gold); font-size: 17px; -unity-font-style: bold; }
.ec-win-tb > .ec-icon { margin-right: 6px; }
.ec-win-back { position: absolute; left: 4px; top: 2px; height: 30px; flex-direction: row; align-items: center; padding: 2px 8px; }
.ec-win-close { position: absolute; right: 4px; top: 2px; height: 30px; width: 36px; align-items: center; justify-content: center; padding: 2px; }
.ec-win-body { flex-grow: 1; flex-direction: row; padding-top: 8px; min-height: 0; }
.ec-win-rail { width: 200px; flex-shrink: 0; margin-right: 8px; }
.ec-win-main { flex-grow: 1; min-width: 0; }
.ec-opt { flex-direction: row; align-items: center; padding: 3px 6px; min-height: 34px; }
.ec-opt.ec-alt { background-color: var(--ec-ins); }
.ec-opt > .ec-icon { margin-right: 6px; }
.ec-opt > .ec-label { -unity-text-align: middle-left; flex-grow: 1; }
.ec-opt-n { color: var(--ec-grey); font-size: 11px; }
.ec-opt.ec-active { border-width: 1px; border-color: var(--ec-gold); }
.ec-opt.ec-active > .ec-label { color: var(--ec-gold); -unity-font-style: bold; }
.ec-hd { flex-direction: row; align-items: center; height: 28px; flex-shrink: 0; margin-bottom: 4px; }
.ec-hd-title { color: var(--ec-gold); font-size: 17px; -unity-font-style: bold; }
.ec-hd-note { margin-left: auto; color: var(--ec-sub); font-size: 12px; }
.ec-kpis { flex-direction: row; margin-bottom: 6px; flex-shrink: 0; }
.ec-kpi { flex-grow: 1; flex-basis: 0; margin-right: 4px; padding: 7px 10px; }
.ec-kpi-l { color: var(--ec-grey); font-size: 11px; }
.ec-kpi-n { color: var(--ec-val); font-size: 18px; -unity-font-style: bold; }
.ec-card { padding: 8px 10px; margin-bottom: 6px; flex-shrink: 0; }
.ec-two { flex-direction: row; flex-shrink: 0; }
.ec-two > .ec-card { flex-grow: 1; flex-basis: 0; margin-right: 4px; }
.ec-text { color: var(--ec-sub); font-size: 12px; white-space: normal; }
.ec-empty { color: var(--ec-sub); font-size: 13px; white-space: normal; -unity-text-align: middle-center; padding: 26px 18px; }
.ec-swatch { width: 14px; height: 14px; margin-right: 6px; border-width: 1px; border-color: var(--ec-line); flex-shrink: 0; }
.ec-field { margin: 3px 0; }
.ec-field .unity-base-field__label { min-width: 96px; color: var(--ec-grey); }
.ec-field .unity-base-field__input { background-color: var(--ec-ins); color: var(--ec-val); border-color: var(--ec-line); }
.ec-theme-card { flex-grow: 1; flex-basis: 0; align-items: center; padding: 10px 6px; margin-right: 4px; }
.ec-theme-swatches { flex-direction: row; margin: 6px 0 4px 0; }
.ec-theme-swatches > VisualElement { width: 18px; height: 18px; margin: 0 2px; border-width: 1px; border-color: rgb(0, 0, 0); }

/* ---------- 卷册 archive windows (after the mod's wide windows) ---------- */
/* Figure colours, the same in every theme: good, bad, information, key, cost, muted. */
.ec-t-g { color: rgb(101, 214, 110); }
.ec-t-r { color: rgb(255, 102, 102); }
.ec-t-c { color: rgb(127, 216, 234); }
.ec-t-y { color: var(--ec-gold); }
.ec-t-o { color: rgb(233, 168, 91); }
.ec-t-m { color: var(--ec-grey); }
.ec-f-g { background-color: rgb(101, 214, 110); }
.ec-f-r { background-color: rgb(255, 102, 102); }
.ec-f-c { background-color: rgb(127, 216, 234); }
.ec-f-y { background-color: var(--ec-gold); }
.ec-f-o { background-color: rgb(233, 168, 91); }
.ec-f-m { background-color: var(--ec-grey); }

.ec-arc { width: 1000px; height: 690px; top: 58px; }
.ec-arc-rail { width: 236px; flex-shrink: 0; margin-right: 8px; }
.ec-arc-card { margin-bottom: 6px; }
.ec-arc-grow { flex-grow: 1; }

.ec-arc-id { padding: 9px 11px; margin-bottom: 6px; flex-shrink: 0; }
.ec-arc-id-top { flex-direction: row; align-items: center; }
.ec-arc-flag { width: 28px; height: 28px; margin-right: 8px; border-width: 2px; border-color: rgb(0, 0, 0); align-items: center; justify-content: center; flex-shrink: 0; }
.ec-arc-flag-t { color: rgb(255, 255, 255); font-size: 14px; -unity-font-style: bold; }
.ec-arc-id-name { color: var(--ec-gold); font-size: 19px; -unity-font-style: bold; flex-shrink: 1; white-space: normal; }
.ec-arc-id-l1 { color: var(--ec-sub); font-size: 12px; margin-top: 3px; white-space: normal; }
.ec-arc-id-l2 { color: var(--ec-cyan); font-size: 12px; white-space: normal; }
.ec-arc-tag { color: var(--ec-gold); font-size: 11px; padding: 0 5px; margin-left: 6px; border-width: 1px; border-color: var(--ec-line); background-color: var(--ec-ins); }

.ec-arc-person { flex-direction: row; align-items: center; padding: 3px 2px; }
.ec-arc-ava { width: 36px; height: 36px; margin-right: 8px; flex-shrink: 0; align-items: center; justify-content: center;
    border-width: 2px; border-color: var(--ec-line); background-color: var(--ec-title); }
.ec-arc-ava-sm { width: 30px; height: 30px; }
.ec-arc-pcol { flex-shrink: 1; flex-grow: 1; }
.ec-arc-role { color: var(--ec-cyan); font-size: 11px; }
.ec-arc-pname { color: var(--ec-gold); font-size: 14px; -unity-font-style: bold; }
.ec-arc-pnote { color: var(--ec-grey); font-size: 11px; white-space: normal; }

.ec-arc-mhead { color: var(--ec-cyan); font-size: 12px; margin: 2px 0 2px 2px; }
.ec-arc-mi { flex-direction: row; align-items: center; padding: 3px 6px; min-height: 26px; }
.ec-arc-mi > .ec-icon { margin-right: 6px; }
.ec-arc-mi > .ec-label { -unity-text-align: middle-left; flex-grow: 1; font-size: 13px; }
.ec-arc-mi.ec-active { border-width: 1px; border-color: var(--ec-gold); background-color: var(--ec-title); }
.ec-arc-mi.ec-active > .ec-label { color: var(--ec-gold); -unity-font-style: bold; }
.ec-arc-mi.ec-active > .ec-opt-n { color: var(--ec-gold); }

.ec-arc-chips { margin-left: auto; flex-direction: row; align-items: center; }
.ec-arc-hnote { color: var(--ec-sub); font-size: 12px; margin-right: 6px; }
.ec-arc-chip { height: 24px; padding: 2px 8px; margin-left: 4px; justify-content: center;
    border-width: 1px; border-color: var(--ec-line); background-color: var(--ec-ins); }
.ec-arc-chip > .ec-label { font-size: 12px; }
.ec-arc-chip.ec-on { border-color: var(--ec-gold); background-color: var(--ec-title); }
.ec-arc-chip.ec-on > .ec-label { color: var(--ec-gold); }
.ec-arc .ec-kpi-n { font-size: 22px; }
.ec-arc .ec-kpis { margin-right: -4px; }

/* USS has no :last-child: the row reaches 6 px past the column and every child keeps its margin. */
.ec-arc-cols { flex-direction: row; flex-shrink: 0; margin-right: -6px; }
.ec-arc-cols > * { flex-grow: 1; flex-basis: 0; margin-right: 6px; min-width: 0; }

.ec-arc-bar { flex-direction: row; align-items: center; height: 20px; }
.ec-arc-bar-l { color: var(--ec-sub); font-size: 12px; width: 70px; flex-shrink: 0; }
.ec-arc-track { flex-grow: 1; height: 8px; margin: 0 8px; background-color: var(--ec-title); border-width: 1px; border-color: rgb(0, 0, 0); }
.ec-arc-fill { height: 100%; }
.ec-arc-bar-v { font-size: 12px; min-width: 52px; -unity-text-align: middle-right; color: var(--ec-val); }

.ec-arc-group { flex-direction: row; align-items: center; height: 26px; padding: 0 10px; margin-bottom: 6px; flex-shrink: 0;
    border-width: 2px; border-color: var(--ec-line); background-color: var(--ec-ins); }
.ec-arc-group-t { font-size: 13px; -unity-font-style: bold; }
.ec-arc-group-n { color: var(--ec-grey); font-size: 12px; margin-left: 6px; }

.ec-arc-line { flex-direction: row; align-items: center; min-height: 22px; padding: 1px 5px; }
.ec-arc-line.ec-alt { background-color: var(--ec-ins); }
.ec-arc-line > Label { font-size: 12px; color: var(--ec-val); margin-right: 8px; }
.ec-arc-line > Label.ec-t-m { color: var(--ec-grey); }
.ec-arc-line.ec-click:hover { background-color: var(--ec-title); }

.ec-arc-realm { padding-top: 0; }
.ec-arc-realm.ec-click:hover { border-color: var(--ec-gold); }
.ec-arc-strip { height: 5px; margin: 0 -2px 6px -2px; }
.ec-arc-rhead { flex-direction: row; align-items: center; border-bottom-width: 1px; border-bottom-color: var(--ec-line); padding-bottom: 3px; margin-bottom: 3px; }
.ec-arc-rname { font-size: 15px; -unity-font-style: bold; }
.ec-arc-rnote { color: var(--ec-grey); font-size: 11px; }
.ec-arc-stats { flex-direction: row; margin-top: 4px; padding: 3px 6px; background-color: var(--ec-page); border-width: 1px; border-color: var(--ec-line); }
.ec-arc-stat { flex-grow: 1; flex-basis: 0; }
.ec-arc-stat-l { color: var(--ec-grey); font-size: 11px; }
.ec-arc-stat-v { color: var(--ec-val); font-size: 15px; -unity-font-style: bold; }

.ec-arc-year { color: var(--ec-gold); font-size: 13px; -unity-font-style: bold; margin: 5px 0 1px 2px; }
.ec-arc-ev { flex-direction: row; min-height: 21px; align-items: center; padding: 1px 4px; border-bottom-width: 1px; border-bottom-color: var(--ec-ins); }
.ec-arc-ev.ec-click:hover { background-color: var(--ec-title); }
.ec-arc-ev-m { color: var(--ec-grey); font-size: 12px; width: 46px; flex-shrink: 0; }
.ec-arc-ev-t { color: var(--ec-val); font-size: 12px; white-space: normal; flex-shrink: 1; }

.ec-arc-tiles { flex-direction: row; flex-wrap: wrap; }
.ec-arc-tile { width: 32%; flex-direction: row; align-items: center; padding: 3px; margin: 0 1% 4px 0;
    border-width: 1px; border-color: var(--ec-line); background-color: var(--ec-ins); }
.ec-arc-tile.ec-active { border-color: var(--ec-gold); }
.ec-arc-tile.ec-click:hover { border-color: var(--ec-gold); }
.ec-arc-tname { color: var(--ec-val); font-size: 12px; }

/* Labels in the archive windows drop UI Toolkit's default label margin and padding,
   so the left column (identity, people, figures, menu) fits without scrolling. */
.ec-arc Label { margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; }
.ec-arc-rail .ec-arc-card { padding: 6px 8px; margin-bottom: 4px; }
.ec-arc-rail .ec-arc-id { padding: 7px 10px; margin-bottom: 4px; }
.ec-arc-rail .ec-row { min-height: 19px; padding: 1px 5px; }
.ec-arc-rail .ec-arc-person { padding: 1px 0; }
.ec-arc-rail .ec-arc-ava { width: 30px; height: 30px; }
.ec-arc-rail .ec-arc-mi { min-height: 23px; padding: 2px 6px; }
.ec-arc .ec-hd { margin-bottom: 2px; }
.ec-arc .ec-kpi { padding: 5px 10px; }
.ec-arc .ec-card { margin-bottom: 5px; }
.ec-arc .unity-scroller--vertical { width: 8px; }
.ec-arc .unity-scroller__low-button, .ec-arc .unity-scroller__high-button { display: none; }
.ec-arc .unity-base-slider__tracker { background-color: var(--ec-ins); border-width: 0; }
.ec-arc .unity-base-slider__dragger { background-color: var(--ec-line); border-width: 0; }

/* ===================================================================================
   漆器朱 lacquer theme: the house style (docs/design/ui-style.md, reference v5).
   Pixel frames from Frames/Lacquer (1:1, point-filtered, nine-sliced); the pixel font is
   set on the panel root in code (PixelFont). Layout rules for the shared components come
   first (all themes), then the lacquer textures.
   =================================================================================== */
.theme-lacquer {
    --ec-gold: rgb(246, 212, 138); --ec-cyan: rgb(127, 216, 234); --ec-grey: rgb(138, 122, 106);
    --ec-val: rgb(242, 230, 212); --ec-sub: rgb(203, 184, 162); --ec-title: rgb(42, 30, 26);
    --ec-ins: rgb(21, 16, 14); --ec-line: rgb(78, 64, 58); --ec-page: rgb(26, 19, 17);
}

/* ---------- shared component layout ---------- */
.ec-prow { flex-direction: row; align-items: center; }
.ec-pcol { flex-direction: column; }
.ec-icon.ec-xs { width: 14px; height: 14px; }
.ec-icon.ec-md { width: 32px; height: 32px; }
.ec-phead { flex-direction: row; align-items: center; height: 26px; flex-shrink: 0; margin-bottom: 6px; }
.ec-phead-t { color: var(--ec-gold); font-size: 16px; }
.ec-phead-q { color: var(--ec-sub); font-size: 12px; }
.ec-lead { flex-grow: 1; height: 2px; margin: 0 8px; background-color: var(--ec-line); }
.ec-arc .ec-kpis { margin-right: -8px; margin-bottom: 8px; }
.ec-arc .ec-kpi { margin-right: 8px; }
.ec-pgrid { flex-direction: column; flex-shrink: 0; }
.ec-pgrid-row { flex-direction: row; margin-right: -8px; margin-bottom: 8px; }
.ec-pgrid-cell { flex-grow: 1; flex-basis: 0; margin-right: 8px; margin-bottom: 0; }
.ec-icard { flex-direction: column; }
.ec-icard > .ec-ch { border-bottom-width: 0; margin-bottom: 4px; }
.ec-icard > .ec-ch > .ec-badge { margin-left: 4px; }
.ec-verdict { color: rgb(240, 160, 80); white-space: normal; margin-top: 4px; font-size: 12px; }
.ec-list { background-color: var(--ec-ins); border-width: 2px; border-color: rgb(12, 8, 7); border-top-color: rgb(6, 4, 3); margin-top: 2px; }
.ec-li { flex-direction: row; align-items: center; padding: 2px 6px; min-height: 24px; }
.ec-li.ec-alt { background-color: rgb(29, 22, 19); }
.ec-li-head { min-height: 18px; }
.ec-li-name { flex-grow: 1; flex-shrink: 1; -unity-text-align: middle-left; white-space: nowrap; overflow: hidden; color: var(--ec-val); }
.ec-li-v { min-width: 54px; -unity-text-align: middle-right; color: var(--ec-val); }
.ec-li-col { width: 28px; -unity-text-align: middle-right; color: var(--ec-val); flex-shrink: 0; }
.ec-li > .ec-badge { margin-left: 6px; }
.ec-li > .ec-pbtn { margin-left: 6px; }
.ec-dot { width: 8px; height: 8px; border-width: 1px; border-color: rgb(12, 8, 7); margin-right: 6px; flex-shrink: 0; }
.ec-legend2 { flex-direction: row; flex-wrap: wrap; margin: 2px 0; }
.ec-legend2-i { flex-direction: row; align-items: center; margin-right: 10px; }
.ec-legend2-i > .ec-label { color: var(--ec-sub); font-size: 12px; }
.ec-chipgrid { flex-direction: row; flex-wrap: wrap; margin: 2px -4px 2px 0; }
.ec-chipcell { padding: 0 4px 4px 0; }
.ec-chipcell > .ec-arc-chip { margin-left: 0; height: 24px; }
.ec-pbtn { flex-direction: row; align-items: center; justify-content: center; height: 26px; padding: 2px 10px 4px 10px; flex-shrink: 0; }
.ec-pbtn > .ec-icon { margin-right: 4px; }
.ec-pb-big { height: 32px; margin-top: 6px; }
.ec-badge { padding: 0 5px 1px 5px; color: var(--ec-gold); font-size: 12px; flex-shrink: 0; border-width: 1px; border-color: var(--ec-line); }
.ec-toast { flex-direction: row; align-items: center; padding: 4px 10px; margin-bottom: 6px; flex-shrink: 0; border-width: 2px; border-color: rgb(63, 154, 72); background-color: rgb(20, 32, 15); }
.ec-toast > .ec-icon { margin-right: 6px; }
.ec-toast-t { color: rgb(101, 214, 110); white-space: normal; }
.ec-toast-bad { border-color: rgb(138, 50, 50); background-color: rgb(36, 16, 14); }
.ec-toast-bad > .ec-toast-t { color: rgb(255, 122, 102); }
.ec-steprow { flex-direction: row; align-items: center; margin: 2px 0; }
.ec-step { width: 18px; height: 18px; align-items: center; justify-content: center; margin-right: 6px; flex-shrink: 0; background-color: rgb(138, 106, 34); }
.ec-step-done { background-color: rgb(46, 106, 48); }
.ec-step-todo { background-color: rgb(42, 34, 32); }
.ec-step-t { color: rgb(255, 243, 200); font-size: 12px; -unity-text-align: middle-center; }
.ec-step-todo > .ec-step-t { color: var(--ec-grey); }
.ec-steprow-t { color: var(--ec-val); white-space: normal; flex-shrink: 1; }
.ec-tug { flex-direction: row; align-items: center; margin: 2px 0; }
.ec-tug-a { width: 46px; -unity-text-align: middle-right; color: var(--ec-gold); margin-right: 4px; }
.ec-tug-b { width: 46px; margin-left: 4px; color: var(--ec-val); }
.ec-tug > .ec-icon { margin: 0 4px; }
.ec-ptrack { flex-grow: 1; flex-basis: 0; height: 12px; flex-direction: row; padding: 2px; background-color: var(--ec-ins); }
.ec-ptrack-r { flex-direction: row-reverse; }
.ec-pfill { height: 100%; border-top-width: 2px; border-bottom-width: 2px; border-top-color: rgba(255, 255, 255, 0.3); border-bottom-color: rgba(0, 0, 0, 0.3); }
.ec-meter { flex-direction: row; align-items: center; margin: 2px 0; }
.ec-meter-l { width: 16px; color: var(--ec-sub); }
.ec-meter-v { width: 24px; -unity-text-align: middle-right; color: var(--ec-val); }
.ec-meter > .ec-ptrack { height: 10px; }
.ec-stile { flex-direction: row; align-items: center; flex-grow: 1; flex-basis: 0; margin-right: 4px; padding: 4px 6px; }
.ec-stile-l { color: var(--ec-grey); margin: 0 4px; }
.ec-stile-v { color: var(--ec-val); }
.ec-pflag { width: 22px; height: 22px; border-width: 2px; border-color: rgb(12, 8, 7); align-items: center; justify-content: center; margin-right: 6px; flex-shrink: 0;
    border-top-color: rgba(255, 255, 255, 0.45); border-left-color: rgba(255, 255, 255, 0.45); }
.ec-pflag-t { color: rgb(255, 255, 255); font-size: 12px; -unity-text-align: middle-center; text-shadow: 1px 1px 0 rgb(0, 0, 0); }
.ec-lockrow { flex-direction: row; align-items: center; margin-top: 2px; flex-shrink: 0; }
.ec-lockrow-l { color: var(--ec-grey); margin: 0 4px 0 8px; }
.ec-lockchip { flex-direction: row; align-items: center; padding: 2px 8px 3px 6px; margin-left: 4px; }
.ec-lockchip > .ec-icon { -unity-background-image-tint-color: rgb(110, 100, 90); margin-right: 3px; }
.ec-lockchip > .ec-label { color: var(--ec-grey); }
.ec-mappick { background-color: rgb(12, 8, 7); padding: 2px; align-self: center; margin: 2px 0; flex-shrink: 0; }
.ec-mappick-img { position: absolute; left: 2px; top: 2px; -unity-background-scale-mode: stretch-to-fill; }
.ec-mappick-labels { position: absolute; left: 2px; top: 2px; right: 2px; bottom: 2px; overflow: hidden; }
.ec-mappick-label { position: absolute; translate: -50% -50%; color: rgb(255, 255, 255); font-size: 12px; text-shadow: 1px 1px 0 rgb(0, 0, 0); margin: 0; padding: 0; }
.ec-mapmodes { justify-content: flex-end; margin-bottom: 2px; }
.ec-mapmodes > .ec-arc-chip { height: 22px; }

/* ---------- lacquer textures ---------- */
.theme-lacquer .ec-frame {
    background-image: resource("EmpireCraft/Frames/Lacquer/card");
    -unity-slice-left: 12; -unity-slice-right: 12; -unity-slice-top: 12; -unity-slice-bottom: 12; -unity-slice-type: sliced;
    padding: 10px 12px;
}
.theme-lacquer .ec-frame.ec-on, .theme-lacquer .ec-frame.ec-sel { background-image: resource("EmpireCraft/Frames/Lacquer/card_gold"); }
.theme-lacquer .ec-frame.ec-k-dim { background-image: resource("EmpireCraft/Frames/Lacquer/card_dim"); }
.theme-lacquer .ec-kpi { padding: 8px 12px; }
.theme-lacquer .ec-kpi-l { color: var(--ec-sub); }
.theme-lacquer .ec-hud .ec-kpi-n { font-size: 24px; }
/* window and title bar */
.theme-lacquer .ec-win {
    background-image: resource("EmpireCraft/Frames/Lacquer/window");
    -unity-slice-left: 8; -unity-slice-right: 8; -unity-slice-top: 8; -unity-slice-bottom: 8; padding: 8px;
}
.theme-lacquer .ec-win-tb {
    background-color: rgba(0, 0, 0, 0); border-bottom-width: 0; height: 38px;
    background-image: resource("EmpireCraft/Frames/Lacquer/titlebar");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 4; -unity-slice-bottom: 6;
}
.theme-lacquer .ec-hud .ec-win-title { font-size: 16px; color: var(--ec-gold); text-shadow: 2px 2px 0 rgb(0, 0, 0); }
.theme-lacquer .ec-hud .ec-phead-t { text-shadow: 2px 2px 0 rgb(0, 0, 0); }
/* buttons: notched, lit on top, dark below; pressed when on */
.theme-lacquer .ec-ib, .theme-lacquer .ec-mode, .theme-lacquer .ec-vbtn, .theme-lacquer .ec-cat, .theme-lacquer .ec-tool,
.theme-lacquer .ec-btn, .theme-lacquer .ec-chip, .theme-lacquer .ec-win-back, .theme-lacquer .ec-win-close,
.theme-lacquer .ec-pbtn, .theme-lacquer .ec-arc-chip, .theme-lacquer .ec-theme-card {
    background-image: resource("EmpireCraft/Frames/Lacquer/btn");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 6; -unity-slice-type: sliced;
    border-width: 0; background-color: rgba(0, 0, 0, 0);
}
.theme-lacquer .ec-ib.ec-on, .theme-lacquer .ec-mode.ec-on, .theme-lacquer .ec-vbtn.ec-on, .theme-lacquer .ec-cat.ec-on, .theme-lacquer .ec-tool.ec-on,
.theme-lacquer .ec-ib.ec-sel, .theme-lacquer .ec-vbtn.ec-sel, .theme-lacquer .ec-tool.ec-sel, .theme-lacquer .ec-chip.ec-on, .theme-lacquer .ec-chip.ec-sel,
.theme-lacquer .ec-arc-chip.ec-on, .theme-lacquer .ec-theme-card.ec-on {
    background-image: resource("EmpireCraft/Frames/Lacquer/btn_pressed");
}
.theme-lacquer .ec-pb-gold { background-image: resource("EmpireCraft/Frames/Lacquer/btn_gold"); }
.theme-lacquer .ec-pb-red { background-image: resource("EmpireCraft/Frames/Lacquer/btn_red"); }
.theme-lacquer .ec-pb-off { background-image: resource("EmpireCraft/Frames/Lacquer/btn_off"); }
.theme-lacquer .ec-hud .ec-pbtn > .ec-label { color: rgb(255, 243, 200); }
.theme-lacquer .ec-hud .ec-pb-plain > .ec-label { color: var(--ec-val); }
.theme-lacquer .ec-hud .ec-pb-off > .ec-label { color: rgb(106, 90, 80); }
.theme-lacquer .ec-hud .ec-on > .ec-label, .theme-lacquer .ec-hud .ec-sel > .ec-label { color: rgb(255, 243, 200); }
/* wells, menu, steps, badges, receipts */
.theme-lacquer .ec-arc-mi {
    background-image: resource("EmpireCraft/Frames/Lacquer/well");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    margin-bottom: 4px; padding: 3px 8px 5px 8px; border-width: 0;
}
.theme-lacquer .ec-arc-mi.ec-active { background-image: resource("EmpireCraft/Frames/Lacquer/btn_gold"); -unity-slice-bottom: 6; background-color: rgba(0, 0, 0, 0); }
.theme-lacquer .ec-hud .ec-arc-mi.ec-active > .ec-label, .theme-lacquer .ec-hud .ec-arc-mi.ec-active > .ec-opt-n { color: rgb(255, 243, 200); }
.theme-lacquer .ec-ptrack { background-image: resource("EmpireCraft/Frames/Lacquer/well"); -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4; background-color: rgba(0, 0, 0, 0); }
.theme-lacquer .ec-step { background-image: resource("EmpireCraft/Frames/Lacquer/btn_gold"); background-color: rgba(0, 0, 0, 0); -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 6; }
.theme-lacquer .ec-step-done { background-image: resource("EmpireCraft/Frames/Lacquer/btn_green"); }
.theme-lacquer .ec-step-todo { background-image: resource("EmpireCraft/Frames/Lacquer/btn_off"); }
.theme-lacquer .ec-badge { border-width: 0; background-image: resource("EmpireCraft/Frames/Lacquer/badge"); -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3; padding: 1px 6px 2px 6px; }
.theme-lacquer .ec-badge-r { background-image: resource("EmpireCraft/Frames/Lacquer/badge_r"); }
.theme-lacquer .ec-badge-g { background-image: resource("EmpireCraft/Frames/Lacquer/badge_g"); }
.theme-lacquer .ec-badge-o { background-image: resource("EmpireCraft/Frames/Lacquer/badge_o"); }
.theme-lacquer .ec-badge-c { background-image: resource("EmpireCraft/Frames/Lacquer/badge_c"); }
.theme-lacquer .ec-badge-m { color: var(--ec-grey); }
.theme-lacquer .ec-toast { border-width: 0; background-color: rgba(0, 0, 0, 0); background-image: resource("EmpireCraft/Frames/Lacquer/toast"); -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4; }
.theme-lacquer .ec-toast-bad { -unity-background-image-tint-color: rgb(255, 150, 140); }
.theme-lacquer .ec-lockchip { background-image: resource("EmpireCraft/Frames/Lacquer/btn_off"); -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4; }
.theme-lacquer .ec-lead { background-color: rgba(0, 0, 0, 0); background-image: resource("EmpireCraft/Frames/Lacquer/lead"); background-repeat: repeat-x; background-size: 6px 2px; }
.theme-lacquer .ec-arc-group { background-image: resource("EmpireCraft/Frames/Lacquer/banner"); -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.theme-lacquer .ec-arc-ava { background-image: resource("EmpireCraft/Frames/Lacquer/medal"); -unity-slice-left: 6; -unity-slice-right: 6; -unity-slice-top: 6; -unity-slice-bottom: 6; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.theme-lacquer .ec-arc-tag { background-image: resource("EmpireCraft/Frames/Lacquer/badge"); -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3; border-width: 0; }
.theme-lacquer .ec-arc-stats { background-image: resource("EmpireCraft/Frames/Lacquer/well"); -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.theme-lacquer .ec-arc-track { background-image: resource("EmpireCraft/Frames/Lacquer/well"); -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4; background-color: rgba(0, 0, 0, 0); border-width: 0; padding: 2px; }
.theme-lacquer .ec-arc-fill { border-top-width: 2px; border-bottom-width: 2px; border-top-color: rgba(255, 255, 255, 0.3); border-bottom-color: rgba(0, 0, 0, 0.3); }
.theme-lacquer .ec-ch { border-bottom-width: 0; }
.theme-lacquer .ec-row.ec-alt, .theme-lacquer .ec-arc-line.ec-alt { background-color: rgb(29, 22, 19); }
/* the pixel font has no bold face: emphasis by colour only */
.theme-lacquer .ec-hud Label { -unity-font-style: normal; }
.theme-lacquer .ec-hud .ec-label, .theme-lacquer .ec-hud .ec-ch-title, .theme-lacquer .ec-hud .ec-hd-title, .theme-lacquer .ec-hud .ec-kpi-n,
.theme-lacquer .ec-hud .ec-date, .theme-lacquer .ec-hud .ec-win-title { -unity-font-style: normal; }

/* save slots */
.ec-savethumb { width: 152px; height: 60px; margin-right: 8px; border-width: 2px; border-color: rgb(12, 8, 7); background-color: rgb(29, 58, 92); -unity-background-scale-mode: stretch-to-fill; flex-shrink: 0; }
.ec-savename { flex-grow: 1; margin: 0 8px 0 0; }
.ec-savename .unity-base-field__input { background-color: var(--ec-ins); color: var(--ec-val); border-color: rgb(12, 8, 7); border-width: 2px; min-height: 26px; padding: 2px 8px; }
.ec-savebtns { margin-top: 6px; }
.ec-savebtns > .ec-pbtn { margin-right: 4px; }

/* share bar (v5 info cards) */
.ec-share { flex-direction: row; height: 16px; border-width: 2px; border-color: rgb(12, 8, 7); background-color: var(--ec-ins); margin: 2px 0; }
.ec-share-seg { height: 100%; border-right-width: 2px; border-right-color: rgb(12, 8, 7); border-top-width: 2px; border-top-color: rgba(255, 255, 255, 0.3); border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0.3); }
