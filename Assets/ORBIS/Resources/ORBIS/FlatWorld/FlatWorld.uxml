<ui:UXML xmlns:ui="UnityEngine.UIElements">
 <ui:Style src="FlatWorld.uss" />
 <ui:VisualElement name="app" class="app">
  <ui:VisualElement name="viewport" class="viewport">
   <ui:VisualElement name="mapScale" class="map-scale" picking-mode="Ignore">
    <ui:Label name="mapScaleDistance" picking-mode="Ignore"/>
    <ui:VisualElement name="mapScaleLine" class="map-scale-line" picking-mode="Ignore"/>
   </ui:VisualElement>
   <ui:VisualElement name="minimapFrame" class="minimap-frame" tooltip="点击小地图定位，保留当前缩放">
    <ui:VisualElement name="minimap" class="minimap"/>
   </ui:VisualElement>
   <ui:VisualElement name="loadingCover" class="loading-cover">
    <ui:Label name="loadingTitle" text="正在准备世界…" class="loading-title"/>
    <ui:Label name="loadingDetail" text="正在预热地形纹理、河网与地表着色器，就绪后自动进入完整画面。" class="loading-detail"/>
   </ui:VisualElement>
  </ui:VisualElement>
  <ui:VisualElement class="header">
   <ui:VisualElement class="title-row">
    <ui:Label text="ORBIS" class="brand"/><ui:Label text="WORLD / ATLAS / DETAIL" class="eyebrow"/>
    <ui:VisualElement class="spacer"/><ui:Button name="pause" text="暂停"/><ui:Button name="speed" text="1×"/>
    <ui:Button name="mode" text="M 展开总览" class="accent"/><ui:Button name="shot" text="截图"/>
   </ui:VisualElement>
   <ui:Label name="stats" text="正在生成世界…" class="stats"/>
  </ui:VisualElement>
  <ui:VisualElement class="sidebar">
   <ui:DropdownField name="layer" label="地图"/>
   <ui:DropdownField name="climateYear" label="同月对比" class="is-hidden"/>
   <ui:DropdownField name="tool" label="操作"/>
   <ui:VisualElement class="row"><ui:Button name="atlas" text="2D 总览" class="grow"/><ui:Button name="focus" text="F 详细图" class="grow"/></ui:VisualElement>
   <ui:VisualElement class="tab-row"><ui:Button name="tabWorld" text="世界" class="tab-button"/><ui:Button name="tabTerrain" text="地形" class="tab-button"/><ui:Button name="tabCivs" text="文明" class="tab-button"/><ui:Button name="tabFiles" text="存档" class="tab-button"/></ui:VisualElement>
   <ui:ScrollView class="tab-scroll" mode="Vertical">
    <ui:VisualElement name="panelWorld" class="tab-page">
     <ui:Label text="同一个世界，三个尺度" class="section"/>
     <ui:Label text="滚轮从星球进入局部地表。M 打开全球总览，再按 M 返回原视图。在总览中按 F 可细看选区，Home 返回星球。" class="muted"/>
     <ui:DropdownField name="cloudQuality" label="画面质量"/><ui:Toggle name="clouds" label="云层与云影"/>
     <ui:Button name="home" text="Home 重置视野"/>
     <ui:Foldout text="生成新世界" value="false">
      <ui:TextField name="seed" label="种子"/><ui:DropdownField name="size" label="地图大小"/><ui:DropdownField name="preset" label="地形"/>
      <ui:Button name="generate" text="生成世界" class="accent"/>
      <ui:Label text="生成将替换当前世界；请先保存。" class="muted"/>
     </ui:Foldout>
     <ui:Foldout text="行星与温室气候 (ExoPlaSim)" value="false">
      <ui:DropdownField name="planetPreset" label="行星预设"/>
      <ui:SliderInt name="planetCo2" label="CO2 (ppm)" low-value="100" high-value="2400" value="360"/>
      <ui:Slider name="planetObliq" label="地轴倾角 (°)" low-value="0" high-value="60" value="23.44"/>
      <ui:Button name="applyPlanet" text="应用行星气候并重算" class="accent"/>
      <ui:Label name="planetSummary" text="1.01 bar · 360 ppm CO2 · 倾角 23.4°" class="muted"/>
     </ui:Foldout>
     <ui:Label name="skyStatus" text="" class="muted"/>
    </ui:VisualElement>
    <ui:VisualElement name="panelTerrain" class="tab-page is-hidden">
     <ui:Label text="地图与编辑" class="section"/>
     <ui:Button name="climateStatistics" text="气候统计图集" class="accent"/>
     <ui:Toggle name="grid" label="G 地块网格"/><ui:Toggle name="contours" label="C 等高线"/>
     <ui:Label text="在上方「操作」选择高度笔刷、道路、桥梁或路径；球体和展开途中仅支持查看。" class="muted"/>
     <ui:DropdownField name="height" label="笔刷高度"/><ui:DropdownField name="brush" label="笔刷大小"/>
     <ui:Button name="rebuild" text="重算河流与气候"/>
     <ui:VisualElement class="row"><ui:Button name="confluence" text="下一处汇流" class="grow"/><ui:Button name="mouth" text="下一处河口" class="grow"/></ui:VisualElement>
     <ui:Foldout text="局部水灾与海啸 (64×64 SWE)" value="true">
      <ui:VisualElement class="row"><ui:Button name="hazardRainFlood" text="降雨漫堤洪水" class="grow"/><ui:Button name="hazardTyphoon" text="台风风暴潮" class="grow"/></ui:VisualElement>
      <ui:VisualElement class="row"><ui:Button name="hazardTsunami" text="海床位移海啸" class="grow accent"/><ui:Button name="hazardFocus" text="定位灾区" class="grow"/></ui:VisualElement>
      <ui:VisualElement class="row"><ui:Button name="hazardDemoEastChinaSea" text="东海台风登陆" class="grow accent"/><ui:Button name="hazardDemoNorthAtlantic" text="北大西洋飓风登陆" class="grow accent"/></ui:VisualElement>
      <ui:Toggle name="hazardLiveWeather" text="接通实时台风与暴雨事件" value="true"/>
      <ui:Button name="hazardClear" text="清理退水"/>
      <ui:Button name="hazardReturnOriginal" text="返回原局" class="accent is-hidden"/>
      <ui:Label name="waterStatus" text="" class="muted"/>
     </ui:Foldout>
    </ui:VisualElement>
    <ui:VisualElement name="panelCivs" class="tab-page is-hidden">
     <ui:Label text="文明" class="section"/><ui:Button name="seedCivs" text="播种文明" class="accent"/>
     <ui:Label text="在「操作」选择建立文明、扩张、农田、道路或桥梁，再点击地块。三层视图共用人口、领土与日历。" class="muted"/>
     <ui:Label name="nations" text="等待文明诞生。" class="nations"/>
    </ui:VisualElement>
    <ui:VisualElement name="panelFiles" class="tab-page is-hidden">
     <ui:Label text="世界存档" class="section"/>
     <ui:VisualElement class="row"><ui:Button name="save" text="保存" class="grow"/><ui:Button name="load" text="载入" class="grow"/></ui:VisualElement>
     <ui:Button name="folder" text="打开存档文件夹"/>
     <ui:Foldout text="高度图导入 / 导出" value="false">
      <ui:TextField name="path" label="文件路径"/>
      <ui:Toggle name="preserveElevation" text="按米保留原图高程" tooltip="保留 −4000 至 +4000 米范围内的整数高程。" value="false"/>
      <ui:VisualElement class="row"><ui:Button name="export" text="导出" class="grow"/><ui:Button name="import" text="导入" class="grow"/></ui:VisualElement>
      <ui:Label text="导出含独立透明河网图（.rivers.png）。导入 2:1 灰度高度图后，会基于新地形播种初始文明。" class="muted"/>
     </ui:Foldout>
    </ui:VisualElement>
    <ui:Foldout text="选中地块" value="true" class="inspector-foldout"><ui:Label name="tileInfo" text="点击地图选择地块。" class="tile-info"/></ui:Foldout>
    <ui:Foldout text="图例" value="false"><ui:Label name="legend" text="" class="legend"/></ui:Foldout>
   </ui:ScrollView>
  </ui:VisualElement>
  <ui:VisualElement class="footer"><ui:Label name="notice" text="准备世界数据…" class="notice"/><ui:Label text="滚轮缩放 · 拖动 / WASD 平移 · Space 暂停 · M 总览 / 返回 · F 详细图 · Home 星球" class="hint"/></ui:VisualElement>
  <ui:VisualElement name="climateStatsWindow" class="climate-modal is-hidden">
   <ui:VisualElement name="climateStatsCard" class="climate-card">
    <ui:VisualElement class="climate-heading">
     <ui:Label text="气候统计图集" class="climate-title"/><ui:VisualElement class="spacer"/>
     <ui:Button name="climateStatsRefresh" text="刷新快照"/><ui:Button name="climateStatsClose" text="关闭"/>
    </ui:VisualElement>
    <ui:Label name="climateStatsStatus" class="climate-status"/>
    <ui:ScrollView name="climateStatsScroll" class="climate-scroll" mode="Vertical">
     <ui:VisualElement name="climateStatsBody" class="climate-body">
      <ui:VisualElement class="climate-map-column">
       <ui:VisualElement class="climate-controls">
        <ui:DropdownField name="climateStatsLayer" label="图层" class="climate-control"/>
        <ui:DropdownField name="climateStatsFeature" label="变量" class="climate-control"/>
       </ui:VisualElement>
       <ui:Label name="climateStatsCaption" class="climate-caption"/>
       <ui:VisualElement name="climateStatsMapHost" class="climate-map-host">
        <ui:Image name="climateStatsMap" class="climate-map"/>
        <ui:VisualElement name="climateStatsMarker" class="climate-marker is-hidden" picking-mode="Ignore"/>
       </ui:VisualElement>
       <ui:VisualElement name="climateStatsLegend" class="climate-legend"/>
       <ui:Label text="北向上 · 点击地图查看原始分辨率地块" class="climate-note"/>
       <ui:Label text="区域协方差" class="climate-section"/>
       <ui:DropdownField name="climateStatsMatrixKind" label="参考样本" class="climate-control"/>
       <ui:Label name="climateStatsMatrixLabel" class="climate-note"/>
       <ui:ScrollView name="climateStatsMatrixScroll" class="climate-table-scroll" mode="Horizontal">
        <ui:VisualElement name="climateStatsMatrix" class="climate-table"/>
       </ui:ScrollView>
      </ui:VisualElement>
      <ui:VisualElement class="climate-inspector">
       <ui:Label text="选中地块" class="climate-section"/>
       <ui:Label name="climateStatsSelection" class="climate-selection"/>
       <ui:Label name="climateStatsDetails" class="climate-details"/>
      </ui:VisualElement>
     </ui:VisualElement>
    </ui:ScrollView>
   </ui:VisualElement>
  </ui:VisualElement>
 </ui:VisualElement>
</ui:UXML>
