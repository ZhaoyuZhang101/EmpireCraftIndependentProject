.app { position: absolute; left: 0; right: 0; top: 0; bottom: 0; color: rgb(222,231,229); font-size: 13px; }
.viewport { position: absolute; left: 280px; right: 0; top: 90px; bottom: 64px; }
.minimap-frame { position: absolute; right: 12px; bottom: 12px; padding: 3px; background-color: rgb(21,32,35); border-width: 1px; border-color: rgb(164,145,101); }
.minimap-frame:hover { border-color: rgb(231,202,140); }
.minimap { flex-grow: 1; overflow: hidden; background-color: rgb(21,32,35); }
.header { position: absolute; left: 0; right: 0; top: 0; height: 90px; background-color: rgba(14,25,30,0.97); padding: 12px 20px; border-bottom-width: 1px; border-bottom-color: rgb(53,70,71); }
.title-row { flex-direction: row; align-items: center; height: 36px; }
.brand { font-size: 28px; -unity-font-style: bold; color: rgb(238,228,198); margin-right: 18px; }
.eyebrow { font-size: 12px; color: rgb(130,166,158); }
.spacer { flex-grow: 1; }
.stats { margin-top: 7px; color: rgb(173,193,183); font-size: 12px; }
.sidebar { position: absolute; left: 0; top: 90px; bottom: 64px; width: 280px; padding: 0 13px 18px 16px; background-color: rgba(18,30,34,0.98); border-right-width: 1px; border-right-color: rgb(49,67,69); }
.section { margin-top: 20px; margin-bottom: 9px; color: rgb(218,184,121); -unity-font-style: bold; font-size: 12px; }
.row { flex-direction: row; margin-top: 5px; }
.grow { flex-grow: 1; }
Button { background-color: rgb(37,54,60); color: rgb(225,232,221); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-color: rgb(62,82,84); border-right-color: rgb(62,82,84); border-bottom-color: rgb(62,82,84); border-left-color: rgb(62,82,84); border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; min-height: 28px; margin: 3px 3px 3px 0; padding: 4px 10px; }
Button:hover { background-color: rgb(58,77,78); }
Button.accent { background-color: rgb(66,101,86); border-top-color: rgb(99,139,111); border-right-color: rgb(99,139,111); border-bottom-color: rgb(99,139,111); border-left-color: rgb(99,139,111); }
.unity-base-field { margin: 5px 0; }
.unity-base-field__label { min-width: 88px; color: rgb(175,196,189); }
.unity-base-field__input { background-color: rgb(28,42,47); color: rgb(228,235,226); min-height: 25px; }
.unity-text-field__input { color: rgb(228,235,226); }
.unity-popup-field__text { color: rgb(228,235,226); }
.unity-toggle__input { background-color: rgba(0,0,0,0); }
.muted { color: rgb(132,158,153); font-size: 11px; white-space: normal; margin-top: 7px; }
.tile-info { background-color: rgb(24,40,43); padding: 12px; white-space: normal; color: rgb(218,229,213); }
.nations { white-space: normal; color: rgb(199,215,203); }
.footer { position: absolute; left: 0; right: 0; bottom: 0; height: 64px; background-color: rgba(13,24,29,0.97); padding: 9px 20px; border-top-width: 1px; border-top-color: rgb(50,71,73); }
.notice { white-space: normal; font-size: 12px; color: rgb(220,211,180); }
.hint { margin-top: 5px; color: rgb(124,154,151); font-size: 11px; }
.tab-row { flex-direction: row; flex-shrink: 0; }
.tab-button { flex-grow: 1; flex-basis: 0; padding-left: 3px; padding-right: 3px; min-height: 32px; }
Button.active-tab { background-color: rgb(77,106,83); color: rgb(255,241,207); border-bottom-color: rgb(225,191,125); border-bottom-width: 2px; }
.tab-scroll { flex-grow: 1; min-height: 0; }
.tab-page { padding-bottom: 10px; }
.is-hidden { display: none; }
.unity-foldout { margin-top: 12px; margin-bottom: 4px; }
.unity-foldout__toggle { color: rgb(212,209,180); }
.unity-foldout__content { margin-left: 2px; }
.inspector-foldout { border-top-width: 1px; border-top-color: rgb(62,80,76); padding-top: 8px; }
.legend { font-size: 11px; white-space: normal; color: rgb(185,206,194); padding: 5px 2px; }
.climate-modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(6,14,18,.84); }
.climate-card { width: 96%; height: 94%; max-width: 1240px; background-color: rgb(19,32,37); border-width: 1px; border-color: rgb(90,112,106); padding: 12px 16px; }
.climate-heading { flex-direction: row; align-items: center; flex-shrink: 0; }
.climate-title { font-size: 23px; -unity-font-style: bold; color: rgb(239,228,197); }
.climate-status { color: rgb(175,202,190); white-space: normal; margin: 4px 0 8px 0; }
.climate-scroll { flex-grow: 1; min-height: 0; }
.climate-body { flex-direction: row; align-items: flex-start; }
.climate-body.climate-narrow { flex-direction: column; align-items: stretch; }
.climate-map-column { flex-grow: 2; flex-basis: 0; min-width: 0; margin-right: 16px; }
.climate-inspector { flex-grow: 1; flex-basis: 0; min-width: 0; background-color: rgb(26,43,46); padding: 1px 12px 12px 12px; }
.climate-narrow .climate-map-column { flex-basis: auto; margin-right: 0; }
.climate-narrow .climate-inspector { flex-basis: auto; margin-top: 8px; }
.climate-controls { flex-direction: row; flex-wrap: wrap; }
.climate-control { flex-grow: 1; min-width: 170px; margin-right: 8px; }
.climate-control > .unity-base-field__label { min-width: 42px; }
.climate-caption { color: rgb(231,222,194); white-space: normal; margin: 4px 0 5px 0; }
.climate-map-host { width: 100%; height: 160px; overflow: hidden; background-color: rgb(44,51,60); }
.climate-map { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.climate-marker { position: absolute; width: 12px; height: 12px; margin-left: -6px; margin-top: -6px; border-radius: 6px; border-width: 2px; border-color: white; background-color: rgba(15,22,28,.58); }
.climate-legend { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.climate-key { flex-direction: row; align-items: center; margin: 1px 12px 2px 0; }
.climate-key-mark { width: 13px; height: 13px; margin-right: 4px; border-width: 1px; border-color: rgb(136,142,133); }
.climate-key-text { color: rgb(221,230,218); font-size: 12px; }
.climate-note { color: rgb(166,190,184); font-size: 12px; white-space: normal; margin: 3px 0; }
.climate-section { color: rgb(226,194,136); font-size: 15px; -unity-font-style: bold; margin: 12px 0 5px 0; }
.climate-selection { color: rgb(242,234,206); white-space: normal; margin: 3px 0 5px 0; }
.climate-details { color: rgb(210,227,221); white-space: normal; font-size: 13px; }
.climate-table-scroll { margin-top: 4px; min-width: 0; }
.climate-table-row { flex-direction: row; }
.climate-table-cell { width: 77px; height: 32px; margin: 1px; padding: 1px 2px; -unity-text-align: middle-center; white-space: normal; font-size: 12px; }
.climate-table-axis { background-color: rgb(42,58,62); color: rgb(223,230,216); }
.map-scale { position: absolute; bottom: 12px; left: 12px; align-items: center; background-color: rgba(17,27,30,.84); padding: 2px 6px 5px 6px; border-radius: 2px; }
.map-scale Label { font-size: 12px; color: rgb(240,236,215); -unity-text-align: middle-center; }
.map-scale-line { height: 5px; border-bottom-width: 2px; border-left-width: 1px; border-right-width: 1px; border-color: rgb(240,236,215); }
